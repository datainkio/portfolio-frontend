{% extends "./cols-2-before.njk" %}
{% import "organisms/navigation/docs-nav.njk" as docsNav %}
{% block bodyStyles %}grid grid-cols-12 gap-6 px-4{% endblock bodyStyles %}
{% block mainStyles %}col-span-8 col-start-3{% endblock mainStyles %}
{%- set sidebarBeforeClasses = "" -%}
{%- set sidebarAfterClasses = "" -%}

{% block content %}
  {% if content %}
    {{ content | safe }}
  {% else %}
    {% loremPars 3 %}
  {% endif %}
{% endblock %}

{% if sidebar_after %}
  <aside
    class="text-white font-light text-xs col-span-2 pt-24 {{ sidebarAfterClasses }}"
    data-scroll
    data-scroll-sticky
    data-scroll-target="main">
    {% block sidebar_after %}
      {{ sidebar_after | safe }}
    {% endblock %}
  </aside>
{% endif %}