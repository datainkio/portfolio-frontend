{% extends "./cols-2-before.njk" %}

{% block bodyStyles %}grid grid-cols-12 gap-6 px-4{% endblock bodyStyles %}
{% block mainStyles %}col-span-8 col-start-3{% endblock mainStyles %}
{%- set sidebarBeforeClasses = "" -%}
{%- set sidebarAfterClasses = "" -%}

{% block content %}
  {% if content %}
    {{ content | safe }}
  {% else %}
    {% loremPars 3 %}
  {% endif %}
{% endblock content %}

{% if sidebarAfter %}
  <aside class="text-white font-light text-xs col-span-2 pt-24 {{ sidebarAfterClasses }}"
         data-scroll
         data-scroll-sticky
         data-scroll-target="main">
    {% block sidebarAfter %}
      {{ sidebarAfter | safe }}
    {% endblock sidebarAfter %}
  </aside>
{% endif %}
