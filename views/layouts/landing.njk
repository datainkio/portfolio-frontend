{% extends "layouts/base.njk" %}
{% import "atoms/hanko/hanko.njk" as Hanko %}
{% import "molecules/labels/accession-label.njk" as Label %}

{#- Landing pages run under ScrollSmoother, matching home.njk. base.njk builds
    the #page-main / #page-main-content wrapper when this is set. Nothing a
    landing page renders inside <main> may be position: fixed or sticky — put
    such elements in `block sidebarBefore` (navigation that should precede the
    content) or `block afterMain`. -#}
{% set smoothScroll = true %}

{% block mainStyles %}
  {#- STYLES -#}
  {{ {"base": "mx-auto my-8 grid grid-cols-12 gap-x-8", "sm": "", "md": "", "lg": "max-w-none gap-y-12", "xl": ""} | classes }}
{% endblock mainStyles %}

{%- block sidebarBefore -%}
{%- endblock sidebarBefore -%}

{% block content %}

  {#- STYLES -#}
  {%- set headerStyles = {"base": "col-span-full pt-8", "sm": "", "md": "", "lg": "space-y-8", "xl": ""} -%}
  {%- set headerStyleOverrides = params.headerStyles | default({}) -%}
  {%- set headingStyles = {
    "base": "pl-1 font-display text-6xl leading-12 tracking-loose",
    "sm": "text-7xl leading-14",
    "md": "",
    "lg": "text-6xl leading-12 max-w-1/2",
    "xl": "text-7xl leading-20 max-w-2/3"
  } -%}
  {%- set abstractStyles = {"base": "text-neutral-200 col-span-full prose prose-invert prose-a:text-primary-400 content-start h-auto m-0 mb-6 self-start pl-2"} -%}
  {#- Page body (`pageBody`: the CMS Body field as HTML). Main content, so it
      sits after the header as the first block in <main>'s grid, ahead of
      whatever the page template adds. -#}
  {%- set bodyStyles = {"base": "col-span-full prose prose-invert prose-a:text-primary-400 text-neutral-200 mb-6 pl-2", "lg": "col-span-6"} -%}

  {#- HEADER -#}
  <header data-landing-header
          class="{{ headerStyles | classes }} {{ headerStyleOverrides | classes }}">
    {{ Label.render({
        index: docNo | default("00") ,
    title: params.docTitle | default(eleventyNavigation.title) | default("Untitled"),
    description: "Russ Lebo / Selected Works",
    scope: "2008-" + (buildDate | formatDate("yyyy") )
    }) }}

    <h1 data-landing-header-title class="{{ headingStyles | classes }}">{{ title | default("Untitled") }}</h1>
    {% if abstract and abstract | length > 0 %}
      <section data-doc-abstract class="{{ abstractStyles | classes }}">
        {{ abstract | safe }}
      </section>
    {% endif %}
  </header>

  {#- BODY -#}
  {% if pageBody and pageBody | length > 0 %}
    <section data-landing-body
             class="{{ bodyStyles | classes }}"
             aria-label="Page content">
      {{ pageBody | safe }}
    </section>
  {% endif %}

  {% if content %}
    {{ content | safe }}
  {% elif not title %}
    {% loremPars 3 %}
  {% endif %}

  {% include "layouts/partials/choreography-script/choreography-script.njk" %}
{% endblock content %}
