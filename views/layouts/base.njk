{% import "organisms/header/global-header.njk" as GlobalHeader with context %}
{% import "organisms/footer/global-footer.njk" as Footer with context %}
{% import "organisms/navigation/skip-links-nav.njk" as SkipLinks %}

{%- set brandLogoUrl = cms.siteSettings[0].brand.logo.asset.url if (cms and cms.siteSettings and cms.siteSettings[0] and cms.siteSettings[0].brand and cms.siteSettings[0].brand.logo and cms.siteSettings[0].brand.logo.asset) else "" -%}
{%- set brandLogoSvg = brandLogoUrl | inlineSvgFromUrl -%}

<!DOCTYPE html>
<html lang="en" class="{{ 'debug-outlines' if runtime.debugOutlines }}">
  {% include "templates/partials/dev-note/dev-note.njk" %}
  {% include "templates/partials/head/head.njk" %}
  {% block head %}
  {% endblock head %}
  <body class="{{ {"base": "bg-slate-950 bg-graphpaper-accent-400", "sm": "", "md": "", "lg": "", "xl": ""} | classes }} {% block bodyStyles %}{% endblock bodyStyles %}">

    {# GTM #}
    {% include "templates/partials/gtm-noscript/gtm-noscript.njk" %}

    {# SKIP LINKS #}
    {{ SkipLinks.render() }}

    {# GLOBAL PAGE HEADER #}
    {{ GlobalHeader.render({classes: 'font-display', logoSvg: brandLogoSvg}) }}

    {#- SCROLLSMOOTHER WRAPPER (opt-in) — a template sets `smoothScroll = true`
        to get the same #page-main / #page-main-content pair home.njk builds by
        hand. ScrollSmootherManager only mounts when both ids exist; without
        them the page runs native scroll and scrub-driven motion (card
        sticky/parallax) can't be frame-locked to the compositor on mobile.
        Opt-in rather than default because article.njk renders `sticky top-0`
        inside <main>, which breaks inside the smoothed content. Everything
        that must stay position: fixed (skip links, global header, and any
        `afterMain` content) sits outside #page-main-content. -#}
    {% if smoothScroll %}<div id="page-main">{% endif %}

      {#- SIDEBAR BEFORE -#}
      {% block sidebar_before %}
        <nav class="{{ {"base": "", "sm": "", "md": "", "lg": "", "xl": ""} | classes }} {% block sidebarBeforeStyles %}{% endblock sidebarBeforeStyles %}"
             data-scroll
             data-scroll-sticky
             data-scroll-target="main">
          Hi there.
          This is the sidebar content. You can replace this with your own content or remove it if you don't need a sidebar.
        </nav>
      {% endblock sidebar_before %}


      {# MAIN CONTENT AREA #}
      <main {% if smoothScroll %}id="page-main-content"{% endif %}
            class="{{ {"base": "max-w-[1280px] pt-6 space-y-12 px-6", "sm": "", "md": "pt-8", "lg": "pt-16", "xl": ""} | classes }} {% block mainStyles %}{% endblock mainStyles %}">

        {% block content %}
          {% if content %}
            {{ content | safe }}
          {% else %}
            {% loremPars 3 %}
          {% endif %}
        {% endblock content %}

      </main>

      {#- AFTER MAIN — inside #page-main, outside #page-main-content. The slot for
        anything that must stay position: fixed while ScrollSmoother transforms
        <main> (see the wrapper note above). -#}
      {% block afterMain %}
      {% endblock afterMain %}

      {#- SIDEBAR AFTER -#}
      {% if sidebar_after %}
        <aside class="{{ {"base": "", "sm": "", "md": "", "lg": "", "xl": ""} | classes }} {% block sidebarAfterStyles %}{% endblock sidebarAfterStyles %}"
               data-scroll
               data-scroll-sticky
               data-scroll-target="main">
          {% block sidebar_after %}
            Hi there. This is the sidebar content. You can replace this with your own content or remove it if you don't need a
            sidebar.
          {% endblock sidebar_after %}
        </aside>
      {% endif %}

      {# GLOBAL PAGE FOOTER #}
      {{ Footer.render() }}

      {% if smoothScroll %}</div>{% endif %}

    {#- SCRIPTS -#}
    <script type="module" src="/assets/js/layouts/global-header.js"></script>

    {% block scripts %}
    {% endblock scripts %}
  </body>
</html>
