{% import "atoms/hanko/hanko.njk" as Hanko %}
{% import "molecules/labels/accession-label.njk" as Label %}
{% macro render(params) %}
  {%- set headerStyles = {"base": "col-span-6 content-end gap-8", "sm": "", "md": "", "lg": "", "xl": ""} -%}
  {%- set headingStyles = {
    "base": "col-start-1 font-display text-5xl/12 tracking-loose",
    "sm": "text-6xl/16",
    "md": "text-7xl",
    "lg": "",
    "xl": ""
  } -%}

  <header data-landing-header class="{{ headerStyles | classes }}">
    {{ Label.render({
        index: "03",
        title: "Contact",
        description: "Russ Lebo / Selected Works Archive",
        scope: "2008-" + (buildDate | formatDate("yyyy") )
    }) }}
    <h1 data-landing-header-title class="{{ headingStyles | classes }}">{{ params.title | default("Untitled") }}</h1>
  </header>
{% endmacro %}
