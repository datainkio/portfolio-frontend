{% import "molecules/figure/media.njk" as Media %}

{% macro render(params = {}) %}

  {#- STYLES -#}
  {%- set header = {
    "base": "bg-transparent mt-24 space-y-4 border-0 relative col-span-full overflow-hidden text-neutral-100 bg-slate-700",
    "md": "space-y-[1px] p-[1px] ",
    "lg": "mt-12"
  } -%}
  {%- set capStyles = {"base": "w-full col-span-full font-display text-sm text-neutral-400", "md": "p-2"} -%}
  {%- set headingStyles = {"base": "text-5xl font-display z-[2] text-neutral-100 ", "md": "p-2"} -%}
  {%- set abstractStyles = {"base": "text-neutral-100 font-thin text-xl", "md": "p-2"} -%}

  {%- set imageFigureStyles = {"base": "overflow-hidden"} -%}
  {%- set imageImgStyles = {"base": "w-full h-full object-cover"} -%}
  {%- set imageCaptionStyles = {"base": "mt-2 text-sm text-gray-600"} -%}
  {%- set imageStyles = {"image": imageImgStyles, "caption": imageCaptionStyles} -%}


  <header data-project-header class="{{ [header, params.classes] | classes }}">
    <p class="{{ capStyles | classes }}" data-project-industry>{{ params.project.industry.title | default("") }}</p>
    <h1 id="case-study-title"
        data-landing-header-title
        class="{{ headingStyles | classes }}">{{ params.project.title | default("Untitled") }}</h1>
    <section class="{{ abstractStyles | classes }}" data-project-abstract>
      <p class="prose prose-2xl text-neutral-100 mb-0">{{ params.project.abstract | safe }}</p>
    </section>

    {{ Media.render({ image: params.project.featuredImage, classes: imageFigureStyles, styles: imageStyles }) }}
  </header>
{% endmacro %}
