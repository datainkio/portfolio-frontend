{% import "organisms/navigation/breadcrumbs-nav.njk" as BreadCrumbs with context %}
{% import "organisms/project-metadata/project-metadata.njk" as ProjectMetadata %}
{% import "molecules/list/project-orgs.njk" as ProjectOrgs %}
{% import "molecules/figure/featured-image.njk" as FeaturedImage %}

{% macro render(params) %}

  {%- set header = {
    "base": "m-4 p-[1px] bg-slate-700 gap-[1px] border-0 relative grid grid-cols-3 col-span-full overflow-hidden text-neutral-100",
    "sm": "",
    "md": "",
    "lg": "",
    "xl": ""
  } -%}

  {%- set heading = {
    "base": "px-4 py-6 col-start-1 row-start-2 col-span-2 text-12/12 font-display z-[2] text-neutral-100 bg-slate-950"
  } -%}

  {%- set byline = {
    "base": "bg-slate-950 z-[3] flex text-lg",
    "sm": "",
    "md": "",
    "lg": "",
    "xl": ""
  } -%}

  {%- set image = {
    "base": "p-4 bg-slate-950 col-start-1 row-start-3 col-span-2 w-full aspect-video object-cover z-[1]",
    "sm": "",
    "md": "",
    "lg": "",
    "xl": ""
  } -%}

  {%- set metadata = {
    "base": "col-start-1 row-start-4 col-span-full p-4 m-0 divide-x divide-slate-700 bg-slate-950 grid grid-cols-4",
    "sm": "",
    "md": "",
    "lg": "",
    "xl": ""
  } -%}

  <header data-project-header class="{{ header | classes }}">
    <p class="p-4 col-span-2 bg-slate-950 m-0 font-display text-lg" data-project-industry>
      {{ params.project.industry | default('No industry') }}
    </p>
    <h1 id="case-study-title" data-landing-header-title class="{{ heading | classes }}">
      {{ params.project.title | default('Untitled') }}
      {{ ProjectOrgs.render({ orgs: params.project.organization, class: byline | classes }) }}
    </h1>
    {{ FeaturedImage.render({ image: params.project.featuredImage, alt: params.project.featuredImageAlt, class: image | classes }) }}
    <section
      class="px-4 col-start-3 row-start-1 row-span-3 h-full bg-slate-950 text-lg font-thin text-neutral-100"
      data-project-abstract>
      <h2 class="text-lg py-4 mb-4 border-b-2 border-slate-700 border-dotted">Project Summary</h2>
      {{ params.project.abstract | safe }}
    </section>

    {{ ProjectMetadata.render({ project: params.project, classes: metadata | classes, aria: "Project metadata" }) }}
  </header>
{% endmacro %}