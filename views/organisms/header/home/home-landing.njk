{% import "atoms/hanko/hanko.njk" as Hanko %}

{%- set header = {
        "base": "group fixed h-dvh top-8 pt-4 left-0 z-[9999] bg-slate-950 text-center absolute",
        "data-[header-role=loader]": "w-full text-center pointer-events-auto flex items-center",
        "data-[header-role=hero]": "w-full flex items-center",
        "data-[header-role=dismissed]": "hidden"
} -%}
{%- set hgroup = {"base": "font-display w-24 mx-auto pt-4"} -%}
{%- set hanko = {"base": "hanko block text-secondary-500"} -%}
{%- set heading = {"base": "text-4xl leading-8 text-primary-200 py-6 my-2"} -%}
{%- set subtitle = {"base": "block text-lg tracking-widest p-2  w-full leading-none text-slate-700 border-2 border-slate-700"} -%}

{% macro home_landing(params = {}) %}
        <header id="overview"
                data-preloader
                data-home-header
                data-header-role="loader"
                class="site-hero {{ header | classes }}">
                <hgroup data-preloader-el="hgroup" class="{{ hgroup | classes }}">
                        {{ Hanko.render({svg: params.svg, classes: hanko | classes}) }}
                        <p class="{{ heading | classes }}">Russ Lebo</p>
                        <span class="{{ subtitle | classes }}">UX IXD AIX DX</span>
                </hgroup>
        </header>
        <script>
                (function () {
                        try {
                                var raw = sessionStorage.getItem("dataink_session");
                                var state = raw ? JSON.parse(raw) : null;
                                if (state && state.visited === true) {
                                        var el = document.querySelector("[data-preloader]");
                                        if (el) el.setAttribute("data-preloader-state", "exit");
                                }
                        } catch (e) {
                                // Storage unavailable (private mode, disabled, etc.) — fall
                                // through to the normal first-visit loading sequence.
                        }
                })();
        </script>
{% endmacro %}
