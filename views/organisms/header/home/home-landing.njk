{% import "atoms/hanko/hanko.njk" as Hanko %}
{% import "organisms/navigation/page-nav.njk" as page_nav %}
{%- set header = { 
        base: "fixed h-dvh left-0 w-full z-[9999] grid grid-cols-6 items-center gap-2 justify-center bg-slate-950 pointer-events-auto"
        } -%}
{%- set hanko = {
        base: "hanko text-secondary-500 size-24",
        md: "size-36"
        } -%}
{%- set hgroup = { 
        base: "col-span-5"
        } -%}
{%- set heading = {
        base: "font-display text-4xl text-white"
        } -%}
{%- set subtitle = {
        base: "m-0 p-0 font-display text-md text-white"
        } -%}

{% macro home_landing(params = {}) %}
  <header id="overview" data-preloader data-home-header class="site-hero {{ header | classes }}">
    {{ Hanko.render({svg: params.svg, classes: hanko | classes}) }}
    <hgroup data-preloader-el="hgroup" class="{{ hgroup | classes }}">
      <h1 class="{{ heading | classes }}">Russell Lebo</h1>
      <p class="{{ subtitle | classes }}">Experience Designer &amp; Creative Technologist</p>
    </hgroup>
    {{ page_nav.render({classes: "col-start-1 hidden"}) }}
  </header>
{% endmacro %}