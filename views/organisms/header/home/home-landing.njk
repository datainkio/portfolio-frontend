{% import "atoms/hanko/hanko.njk" as Hanko %}

{% import "organisms/navigation/page-nav.njk" as page_nav %}
{%- set header = {
        "base": "group fixed h-dvh top-8 pt-4 left-0 z-[9999] bg-slate-950 text-center absolute",
        "data-[header-role=loader]": "w-full text-center pointer-events-auto flex items-center",
        "data-[header-role=hero]": "w-full flex items-center",
        "data-[header-role=menu]": "w-12 overflow-hidden shadow-neutral-950/50 shadow-md cursor-pointer border-r-2 border-slate-700 lg:w-48 lg:overflow-visible lg:cursor-auto",
        "data-[header-role=menu]:data-[drawer=open]": "max-lg:w-full max-lg:overflow-auto"
} -%}
{%- set hgroup = {
        "base": "font-display w-24 mx-auto pt-4",
        "group-data-[header-role=menu]": "w-16",
        "max-lg:group-data-[header-role=menu]": "w-8",
        "max-lg:group-data-[header-role=menu]:group-data-[drawer=open]": "w-18 my-2"
} -%}
{%- set hanko = {"base": "hanko block text-secondary-500"} -%}
{%- set heading = {
        "base": "text-4xl leading-8 text-primary-200 py-6 my-2",
        "group-data-[header-role=menu]": "text-2xl leading-5 my-2 py-4",
        "max-lg:group-data-[header-role=menu]": "hidden",
        "max-lg:group-data-[header-role=menu]:group-data-[drawer=open]": "block py-2"
} -%}
{%- set subtitle = {
        "base": "block text-lg tracking-widest p-2  w-full leading-none text-slate-700 border-2 border-slate-700",
        "group-data-[header-role=menu]": "hidden"
} -%}
{%- set pageNav = {
        "base": "col-start-1 hidden mx-auto group-data-[header-role=menu]:group-data-[drawer=open]:block",
        "lg": "group-data-[header-role=menu]:block"
} -%}

{% macro home_landing(params = {}) %}
        <header id="overview"
                data-preloader
                data-home-header
                data-header-role="loader"
                class="site-hero {{ header | classes }}">
                <hgroup data-preloader-el="hgroup" class="{{ hgroup | classes }}">
                        {{ Hanko.render({svg: params.svg, classes: hanko | classes}) }}
                        <h1 class="{{ heading | classes }}">Russ Lebo</h1>
                        <span class="{{ subtitle | classes }}">UX IXD AIX DX</span>
                </hgroup>
                {{ page_nav.render({classes: pageNav | classes}) }}
        </header>
        {# Synchronous, non-module, pre-paint: js/preloader/Preloader.js already
           skips the loading choreography on a repeat visit (SessionManager's
           visited flag), but that check runs from a deferred `type="module"`
           script — after HTML parsing, i.e. after first paint. The pulsing
           `hanko-loading-pulse` animation (styles/components/hanko.css) is
           CSS-only and starts on paint with no JS required, so without this it
           can still flash before the module script gets a chance to run. This
           duplicates the sessionStorage key ("dataink_session") and shape
           (SessionManager.js) and the attribute/value pair (PRELOADER_STATE in
           js/preloader/constants.js) because a synchronous pre-paint check
           can't import an ES module — keep both in sync if either changes. #}
        <script>
                (function () {
                        try {
                                var raw = sessionStorage.getItem("dataink_session");
                                var state = raw ? JSON.parse(raw) : null;
                                if (state && state.visited === true) {
                                        var el = document.querySelector("[data-preloader]");
                                        if (el) el.setAttribute("data-preloader-state", "exit");
                                }
                        } catch (e) {
                                // Storage unavailable (private mode, disabled, etc.) — fall
                                // through to the normal first-visit loading sequence.
                        }
                })();
        </script>
{% endmacro %}
