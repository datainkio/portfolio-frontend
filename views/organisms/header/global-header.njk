{% import "organisms/navigation/primary-nav.njk" as primary_nav with context %}
{% import "atoms/hanko/hanko.njk" as Hanko %}
{% import "molecules/list/build-info.njk" as BuildInfo with context %}

{#- DATA GUARDS -#}

{#- STYLES -#}

{#- container for the global header -#}
{%- set headerClasses = {
  "base": "fixed w-full min-w-screen-sm grid grid-cols-12 items-center divide-x divide-slate-700 z-20 py-2 px-2 gap-2 inner-border font-display text-primary-200 will-change-transform"
} -%}

{#- header's own base background, as a stacked layer rather than the header's
    native background-color: a background-color on <header> itself always
    paints beneath every descendant (negative z-index included), so the
    build-info drawer (build-info.njk, -z-20) could never tuck behind it.
    This backdrop sits at -z-10 — below the header's unpositioned content
    (logo/dt/dd/toggle, which stack above any negative z-index layer
    regardless), but above the drawer. -#}
{%- set headerBackdropClasses = {"base": "absolute inset-0 -z-10 bg-slate-900 pointer-events-none"} -%}

{#- link to home -#}
{%- set logoClasses = {"base": "flex justify-center items-center w-full min-w-10 h-full p-2"} -%}

{#- definition list -#}
{%- set dlClasses = {"base": "col-span-7 grid grid-cols-subgrid grid-rows-2 bg-slate-700 gap-px"} -%}
{%- set dtClasses = {"base": "px-2 text-neutral-500 text-xs content-end h-full bg-slate-900"} -%}
{%- set ddClasses = {
  "base": "row-start-2 px-2 text-xs md:text-sm lg:text-base text-neutral-300 h-full content-center bg-slate-900"
} -%}

{#- page links -#}
{%- set navParams = {"classes": "col-span-4"} -%}

{#- DISPLAY -#}
{% macro render(params = {}) %}

  {%- set logoSvg = params.logoSvg -%}

  <header id="global-header"
          class="{{ headerClasses | classes }} {{ params.classes }}"
          aria-label="Global Site Header">

    <div class="{{ headerBackdropClasses | classes }}" aria-hidden="true"></div>

    {#- HOME LINK -#}
    <a class="{{ logoClasses | classes }}" href="/" aria-label="Home">
      {%- if logoSvg -%}
        {{ Hanko.render({ svg: logoSvg }) }}
      {%- else -%}
        Home
      {%- endif -%}
    </a>

    {#- PAGE INFO -#}
    <dl class="{{ dlClasses | classes }}">

      {#- DOC ID -#}
      <dt class="{{ dtClasses | classes }} sr-only lg:not-sr-only">Doc No.</dt>
      <dd class="{{ ddClasses | classes }} sr-only lg:not-sr-only">
        DOC {{ params.docNo | default("000") }}
      </dd>

      {#- SECTION TITLE -#}
      <dt class="{{ dtClasses | classes }} col-span-3">Section</dt>
      <dd data-current-section-title
          class="{{ ddClasses | classes }} col-span-3 text-secondary-500 ">
        {{ params.sectionTitle | default("Initializing...") }}
      </dd>

      {#-
        BUILD INFO
        Includes show/hide IX for the build details. See js/choreography/managers/BuildInfoManager.js.
      -#}
      <dt class="{{ dtClasses | classes }} col-span-4 lg:col-span-3">Build Info</dt>
      <dd class="{{ ddClasses | classes }} col-span-4 lg:col-span-3 group-data-[open]/cap:basis-1/6 text-neutral-500 text-xs self-center">
        {{ BuildInfo.render({"class": "w-full"}) }}
      </dd>

    </dl>

    {#- MAIN NAVIGATION -#}
    {{ primary_nav.render(navParams) }}

  </header>
{% endmacro %}
