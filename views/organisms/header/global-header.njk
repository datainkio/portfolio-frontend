{% import "organisms/navigation/primary-nav.njk" as primary_nav with context %}
{% import "molecules/section-cap.njk" as SectionCap with context %}

{% macro render(params = {}) %}
  {%- set headerClasses = {
    "base": "fixed w-full overflow-hidden text-md bg-slate-900 font-display text-primary-200 h-20 z-20 will-change-transform"
  } -%}
  <header id="global-header"
          class="{{ headerClasses | classes }} {{ params.classes }}"
          aria-label="Global Site Header">
    {{ primary_nav.render({ logoSvg: params.logoSvg }) }}
    {{ SectionCap.render({ title: params.sectionTitle | default("initializing...") }) }}
  </header>
{% endmacro %}
