{% import "organisms/navigation/primary-nav.njk" as primary_nav with context %}
{% import "atoms/hanko/hanko.njk" as Hanko %}
{% import "molecules/list/build-info.njk" as BuildInfo with context %}

{#- DATA GUARDS -#}

{#- STYLES -#}

{#- container for the global header -#}
{%- set headerClasses = {
  "base": "fixed w-full min-w-screen-sm grid grid-cols-12 items-center divide-x divide-slate-700 z-20 py-2 px-2 inner-border bg-slate-900 font-display text-primary-200 will-change-transform"
} -%}

{#- link to home -#}
{%- set logoClasses = {"base": "flex justify-center items-center w-full min-w-10 h-full p-2"} -%}

{#- definition list -#}
{%- set dlClasses = {"base": "col-span-7 grid grid-cols-subgrid grid-rows-2 bg-slate-700 gap-px", "lg": "col-span-7"} -%}
{%- set dtClasses = {"base": "px-2 text-neutral-500 text-xs content-end h-full bg-slate-900"} -%}
{%- set ddClasses = {"base": "row-start-2 px-2 text-neutral-300 h-full content-center bg-slate-900"} -%}

{#- page links -#}
{%- set navParams = {"classes": "col-span-4"} -%}

{#- DISPLAY -#}
{% macro render(params = {}) %}

  {%- set logoSvg = params.logoSvg -%}

  <header id="global-header"
          class="{{ headerClasses | classes }} {{ params.classes }}"
          aria-label="Global Site Header">

    {#- HOME LINK -#}
    <a class="{{ logoClasses | classes }}" href="/" aria-label="Home">
      {%- if logoSvg -%}
        {{ Hanko.render({ svg: logoSvg }) }}
      {%- else -%}
        Home
      {%- endif -%}
    </a>

    {#- PAGE INFO -#}
    <dl class="{{ dlClasses | classes }}">

      {#- DOC ID -#}
      <dt class="{{ dtClasses | classes }} sr-only lg:not-sr-only">Doc No.</dt>
      <dd class="{{ ddClasses | classes }} sr-only lg:not-sr-only">
        DOC {{ params.docNo | default("000") }}
      </dd>

      {#- SECTION TITLE -#}
      <dt class="{{ dtClasses | classes }} col-span-3">Section</dt>
      <dd data-current-section-title
          class="{{ ddClasses | classes }} text-secondary-500 col-span-3">
        {{ params.sectionTitle | default("Initializing...") }}
      </dd>

      {#- BUILD INFO -#}
      <dt class="{{ dtClasses | classes }} col-span-4">Build Info</dt>
      <dd class="{{ ddClasses | classes }} col-span-4 group-data-[open]/cap:basis-1/6 text-neutral-500 text-xs self-center">
        {{ BuildInfo.render() }}
      </dd>

    </dl>

    {#- MAIN NAVIGATION -#}
    {{ primary_nav.render(navParams) }}

  </header>
{% endmacro %}
