{% import "molecules/list/main-pages.njk" as MainPages %}

{#- STYLES -#}
{%- set headingClasses = {"base": "mb-2 text-xs uppercase tracking-widest text-neutral-500"} -%}
{%- set listClasses = {"base": "space-y-2"} -%}
{#- Design's sections sit beneath the Design link, indented and a step smaller -#}
{%- set subListClasses = {"base": "mt-2 ml-1 pl-4 space-y-1 border-l border-neutral-700"} -%}
{%- set subLinkStyles = {
  "item": {
    "base": ""
  },
  "link": {
    "base": "text-lg text-primary-300 hover:text-primary-100",
    "md": "text-xl"
  }
} -%}
{%- set linkStyles = {
  "item": {
    "base": ""
  },
  "link": {
    "base": "text-2xl text-primary-300 hover:text-primary-100",
    "md": "text-4xl"
  }
} -%}

{#- DISPLAY -#}
{% macro render(params = {}) %}

  {#- DATA GUARDS -#}
  {%- set pages = params.pages or [] -%}

  <nav class="grid grid-cols-2 gap-6 {{ params.classes | classes }}"
       aria-label="Site map">

    {#- Root-level pages. Posts and projects carry no eleventyNavigation key,
        so only their landing pages appear. -#}
    {#- One <section> per column, so each heading stacks with its lists. -#}
    <section>
      <h2 class="{{ headingClasses | classes }}">Pages</h2>
      {{ MainPages.render({ items: pages | eleventyNavigation, currentUrl: params.currentUrl,  classes: subListClasses, styles: subLinkStyles  }) }}
    </section>

    <section>
      {#- "Docs" is the parent the Design and Motion nav roots name but no
          page defines (see ia/docs/design/design.11tydata.js), so its
          children are those two references. -#}
      <h2 class="{{ headingClasses | classes }}">Docs</h2>
      {%- for root in pages | eleventyNavigation("Docs") %}
        {{ MainPages.render({ items: [root], currentUrl: params.currentUrl, classes: listClasses, styles: linkStyles }) }}

        {#- Design's sections only, not their pages, directly beneath the
            Design link. A section with no pages is a dead end, so it waits
            until it has some (as design-pages does). Motion has a section
            per choreography layer, too many to list here; its own sidebar
            carries them. -#}
        {%- if root.key == "Design" %}
          {%- set designSections = [] -%}
          {%- for section in root.children -%}
            {%- if section.children.length -%}{%- set _ = designSections.push(section) -%}{%- endif -%}
          {%- endfor -%}
          {{ MainPages.render({ items: designSections, currentUrl: params.currentUrl, classes: subListClasses, styles: subLinkStyles }) }}
        {%- endif %}
      {%- endfor %}
    </section>

  </nav>
{% endmacro %}
