
{% import "molecules/list/main-pages.njk" as main_pages %}
{% macro render(params = {}) %}

  {#- DATA GUARDS -#}
  {% set cms = params.cms %}
  {% set cmsNavigation = (cms and cms.navigation and cms.navigation[0]) or {} %}
  {% set cmsItems = cmsNavigation.headerItems or [] %}
  {#- An explicit `items` array, even an empty one, is used as-is. -#}
  {% set items = params.items if params.items is defined else cmsItems %}

  {#- STYLES -#}
  {% set ulClasses = {"base": "flex flex-row list-none justify-center content-center divide-x divide-neutral-700"} %}
  {% set liClasses = {"base": "w-full text-center"} %}
  {% set aClasses = {"base": "inline-block text-xs sm:text-sm text-primary-300 whitespace-nowrap", "md": "text-lg"} %}

  {%- set linkStyles = {"item": liClasses, "link": aClasses} -%}

  {#- DISPLAY -#}
  {%- if items.length %}
  <nav id="primary-nav"
       class="{{ params.classes | classes }}"
       aria-label="Primary navigation">
    {{ main_pages.render({
        items: items,
        currentUrl: params.currentUrl,
        classes: ulClasses,
        styles: linkStyles
        }) }}
  </nav>
  {%- endif %}
{% endmacro %}
