
{% import "molecules/list/main-pages.njk" as main_pages %}
{% macro render(params = {}) %}

  {#- DATA GUARDS -#}
  {% set cms = params.cms %}
  {% set cmsNavigation = (cms and cms.navigation and cms.navigation[0]) or {} %}
  {% set cmsItems = cmsNavigation.headerItems or [] %}
  {% set items = params.items or (cmsItems.length and cmsItems) or (params.pages | eleventyNavigation) %}

  {#- STYLES -#}
  {% set ulClasses = {"base": "flex flex-row list-none justify-stretch divide-x divide-slate-700"} %}
  {% set liClasses = {"base": "text-center w-full"} %}
  {% set aClasses = {"base": "inline-block text-xs sm:text-sm text-primary-300 whitespace-nowrap", "md": "text-lg"} %}

  {%- set linkStyles = {"item": liClasses, "link": aClasses} -%}

  {#- DISPLAY -#}
  <nav id="primary-nav"
       class="{{ params.classes | classes }}"
       aria-label="Primary navigation">
    {{ main_pages.render({
        items: items,
        currentUrl: params.currentUrl,
        classes: ulClasses,
        styles: linkStyles
        }) }}
  </nav>
{% endmacro %}
