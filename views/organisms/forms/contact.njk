{%- import "molecules/form/field.njk" as Field -%}
{%- import "molecules/form/honeypot.njk" as Honeypot -%}
{%- import "atoms/button.njk" as Button -%}

{%- macro render(params = {}) -%}
  {#- Browser-write contact form. The Sanity write token is present in this markup as a data attribute — an accepted tradeoff (see contact form spec §4). Submission is JS-dependent (ContactForm.js); the form does not POST on its own. -#}
  {%- set submitLabel = params.submitLabel | default("Send message") -%}
  {%- set sanityProjectId = params.sanityProjectId | default(env.SANITY_PROJECT_ID) -%}
  {%- set sanityDataset = params.sanityDataset | default(env.SANITY_DATASET) -%}
  {%- set sanityApiVersion = params.sanityApiVersion | default(env.SANITY_API_VERSION) -%}
  {%- set sanityWriteToken = params.sanityWriteToken | default(env.SANITY_WRITE_TOKEN) -%}
  {%- set sourcePage = params.sourcePage | default(page.url) -%}
  {%- set sectionId = params.sectionId | default("contact") -%}
  {%- set styles = {"base": "col-span-full grid grid-cols-1 gap-6 px-4 pb-12 max-w-2xl"} -%}
  <form data-contact-form
        data-sanity-project="{{ sanityProjectId }}"
        data-sanity-dataset="{{ sanityDataset }}"
        data-sanity-api-version="{{ sanityApiVersion }}"
        data-sanity-write-token="{{ sanityWriteToken }}"
        class="{{ styles.base | classes }}"
        novalidate>
    <input type="hidden" name="sourcePage" value="{{ sourcePage }}">

    {{ Honeypot.render({ sectionId: sectionId }) }}

    {{ Field.render({
        id: sectionId + "-email",
        name: "email",
        type: "email",
        label: "Email",
        autocomplete: "email",
        required: true,
        fieldStyles: params.fieldStyles
        }) }}

    {{ Field.render({
        id: sectionId + "-message",
        name: "message",
        type: "textarea",
        label: "Message",
        required: true,
        fieldStyles: params.fieldStyles
        }) }}

    <div data-contact-form-status
         aria-live="polite"
         class="text-sm empty:hidden"></div>

    {{ Button.render({ type: "submit", label: submitLabel }) }}
  </form>
  {#- Self-contained progressive enhancement: handles submit, validation, and the direct Sanity write. Module imports are deduped by the browser. -#}
  <script type="module">import "/assets/js/contact-form/ContactForm.js";</script>
{%- endmacro -%}
