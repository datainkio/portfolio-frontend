{%- import "molecules/form/field.njk" as Field -%}
{%- import "molecules/form/honeypot.njk" as Honeypot -%}
{%- import "atoms/button.njk" as Button -%}

{%- macro render(params = {}) -%}
    {#- Browser-write contact form. The Sanity write token is present in this markup as a data attribute — an accepted tradeoff (see contact form spec §4). Submission is JS-dependent (ContactForm.js); the form does not POST on its own. -#}

    {#- DATA GUARDS -#}
    {%- set submitLabel = params.submitLabel | default("Transmit message") -%}
    {%- set sanityProjectId = params.sanityProjectId | default(env.SANITY_PROJECT_ID) -%}
    {%- set sanityDataset = params.sanityDataset | default(env.SANITY_DATASET) -%}
    {%- set sanityApiVersion = params.sanityApiVersion | default(env.SANITY_API_VERSION) -%}
    {%- set sanityWriteToken = params.sanityWriteToken | default(env.SANITY_WRITE_TOKEN) -%}
    {%- set sourcePage = params.sourcePage | default(page.url) -%}
    {%- set sectionId = params.sectionId | default("contact") -%}
    {%- set docNo = params.docNo | default("00") -%}
    {%- set docTitle = params.docTitle | default("Contact") -%}

    {#- STYLES -#}
    {#- Drafting sheet: faint graph grid on the paper, 2px ruled edge (inner-border), registration ticks outside the corners, and a hard offset shadow so the sheet reads as laid on the drafting surface rather than as a panel. -#}
    {%- set formStyles = {"base": "bg-accent-100 registration-marks registration-marks-primary-200 registration-marks-offset-2 text-primary-950 inner-border inner-border-3 inner-border-primary-950 grid grid-cols-subgrid p-2 mb-0 " ~ params.formStyles } -%}

    {#- Fields are drawn into the paper: no inset, paper-toned fill, one light navy rule (text) or a light rectangle (textarea). Strong contrast is reserved for focus (orange-red stamp) and invalid states. -#}
    {%- set fieldBase = "w-full bg-accent-50 text-primary-950 rounded-none px-2 py-1 border-primary-950/30 focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-secondary-500 focus-visible:border-secondary-500 aria-[invalid=true]:border-red-600" -%}
    {%- set lineFieldStyles = fieldBase ~ " border-0 border-b" -%}
    {%- set boxFieldStyles = fieldBase ~ " border" -%}
    {%- set labelStyles = "text-xs font-display uppercase tracking-wider text-primary-950/80 block w-full mb-1" -%}


    <form data-contact-form
          data-sanity-project="{{ sanityProjectId }}"
          data-sanity-dataset="{{ sanityDataset }}"
          data-sanity-api-version="{{ sanityApiVersion }}"
          data-sanity-write-token="{{ sanityWriteToken }}"
          aria-describedby="{{ sectionId }}-description"
          class="{{ formStyles.base | classes }}"
          novalidate>
        <input type="hidden" name="sourcePage" value="{{ sourcePage }}">

        {{ Honeypot.render({ sectionId: sectionId }) }}

        <header class="border-b border-b-2 border-primary-950/85 col-span-full grid grid-cols-subgrid pl-4">
            <p class="m-0 mt-2 text-primary-950 col-span-8 lg:col-span-4 font-display text-xs">Doc {{ docNo }} / Transmission Form</p>
            <h2 class="text-4xl text-primary-950 col-span-8 lg:col-span-4 col-start-1 row-span-2">{{ docTitle }}</h2>
            <ul class="row-span-3 font-display grid grid-cols-1 text-xs row-start-1 row-span-3 col-start-9 lg:col-start-5 col-span-4 lg:col-span-2 divide-y divide-primary-950/50 border-l border-primary-950/85">
                <li class="p-1">DOC {{ docNo }}A</li>
                <li class="p-1">Form 3.14</li>
                <li class="p-1">Sheet 1 of 1</li>
            </ul>
        </header>
        <p id="{{ sectionId }}-description"
           class="font-display pl-5 m-0 border-b border-primary-950/50 col-span-full">Reach out. I'd like to hear from you.</p>
        <ol class="col-span-full grid grid-cols-1 items-start ml-18 border-l border-primary-950/50 list-decimal list-outside marker:h-full marker:font-display marker:text-xl marker:text-left marker:text-primary-950">
            <li class="border-b border-primary-950/50 px-4 pb-4 pt-0">
                {{ Field.render({
                                id: sectionId + "-email",
                                name: "email",
                                type: "email",
                                label: "Email",
                                autocomplete: "email",
                                required: true,
                                fieldStyles: lineFieldStyles,
                                labelStyles: labelStyles
                                }) }}
            </li>
            <li class="px-4 pb-4 pt-0">
                {{ Field.render({
                                id: sectionId + "-message",
                                name: "message",
                                type: "textarea",
                                label: "Message",
                                required: true,
                                fieldStyles: boxFieldStyles,
                                labelStyles: labelStyles
                                }) }}
            </li>
        </ol>
        <footer class="w-full col-span-full grid grid-cols-subgrid gap-x-0 justify-center items-center border-t border-primary-950/85">
            <p data-contact-form-status
               aria-live="polite"
               class="text-sm empty:hidden col-span-full"></p>

            {#- Stamped action mark, not a CTA: flat, tight vertical padding, uppercase display type, trailing arrow, left-aligned to the sheet's pl-4 title-block edge. Full override of the button atom's default styles; disabled/focus affordances restated. -#}
            {%- set buttonStyles = {
                "base": "col-span-full justify-self-start whitespace-nowrap my-3 ml-4 px-4 py-1.5 font-display text-sm uppercase tracking-wider text-neutral-50 bg-secondary-600 hover:bg-secondary-700 border border-secondary-800 rounded-none after:content-['→'] after:ml-3 disabled:opacity-60 disabled:cursor-not-allowed aria-busy:animate-pulse focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-950",
                "lg": "col-span-3"
            } -%}
            {{ Button.render({ type: "submit", label: submitLabel, buttonStyles: buttonStyles | classes }) }}
            <p class="col-span-8 lg:col-span-2 border-t lg:border-t-0 border-l border-primary-950/30 font-display text-sm my-auto py-4 pl-4">No spam. Just me.</p>
            <dl class="col-span-4 col-start-9 lg:col-span-1 lg:col-start-6 font-display text-xs border-t lg:border-t-0 border-l border-primary-950/30 px-2 flex flex-col items-end justify-end h-full">
                <dt class="border-b border-primary-950/30">revision</dt>
                <dd>
                    09.04.26
                </dd>
            </dl>
        </footer>
    </form>
    {#- Self-contained progressive enhancement: handles submit, validation, and the direct Sanity write. Module imports are deduped by the browser. -#}
    <script type="module">import "/assets/js/contact-form/ContactForm.js";</script>
{%- endmacro -%}
