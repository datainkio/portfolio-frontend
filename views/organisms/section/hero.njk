{% macro render(params = {}) %}
  {% import "molecules/labels/accession-label.njk" as Label %}
  {%- set sectionId = params.id | default("hero") -%}
  {%- set classes = params.classes | default("") -%}
  {%- set heading = params.copy.heading -%}
  {%- set subheading = params.copy.subheading -%}
  {%- set body = params.copy.body -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId) -%}
  {%- set buildDate = params.buildDate -%}

  {#- SECTION -#}
  {%- set section_styles = {"base": "relative text-neutral-200 col-span-full grid grid-cols-12 px-4", "sm": "px-8"} -%}

  {#- HERO VIEW -#}
  {%- set header_styles = {
    "base": "h-dvh flex flex-col justify-end z-1 font-display col-span-full gap-y-6 py-12",
    "lg": "col-span-10",
    "xl": "col-span-4"
  } -%}
  {%- set title_styles = {"base": "font-display text-5xl/12 tracking-loose", "sm": "text-6xl/16", "md": "text-7xl"} -%}
  {#- Opaque band behind each line for legibility over the video. Inline + cloned decoration so every line wraps its own ragged-right band, with or without SplitText. -#}
  {%- set title_band_styles = {"base": "bg-neutral-900 box-decoration-clone px-2"} -%}

  {#- MISSION STATEMENT -#}
  {%- set statement_styles = {"base": "h-dvh content-center col-span-full gap-y-12"} -%}
  {%- set subheading_styles = {"base": "sm:text-4xl md:text-5xl font-display text-secondary-500", "md": "col-span-4"} -%}
  {%- set body_styles = {"base": "col-span-full prose prose-p:text-xl prose-invert"} -%}

  <section class="{{ section_styles | classes }}"
           id="{{ sectionId }}"
           aria-labelledby="{{ headingId }}"
           data-scroll-section>
    <header class="{{ header_styles | classes }}" data-hero-el="header">
      {{ Label.render({
            index: "01",
            title: "Manifesto",
            description: "Russell Lebo / Selected Works Archive",
            scope: "2008-" + (buildDate | formatDate("yyyy") ),
      attrs: 'data-hero-el="context"'
      }) }}
      <h1 class="{{ title_styles | classes }}"
          id="{{ headingId }}"
          data-hero-el="heading"><span class="{{ title_band_styles | classes }}" data-hero-el="band">{{ heading }}</span></h1>
    </header>
    <section class="{{ statement_styles | classes }}"
             data-hero-el="mission-statement">
      <h2 class="{{ subheading_styles | classes }}" data-hero-el="subheading">{{ subheading }}</h2>
      <div data-hero-el="body" class="{{ body_styles | classes }}">{{ body | safe }}</div>
    </section>
  </section>
{% endmacro %}
