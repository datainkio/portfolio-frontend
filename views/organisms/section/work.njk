{% macro render(params = {}) %}
  {% import "molecules/card/project.njk" as Card %}
  {% import "molecules/list/industry-links.njk" as Industries %}
  {% import "molecules/section/industry-section.njk" as IndustrySection %}

  {%- set sectionId = params.id | default("work") -%}
  {%- set classes = params.classes | default("") -%}
  {%- set heading = params.copy.heading | default("Work") -%}
  {%- set subheading = params.copy.body | default("<p>Oh noes! Content missing for the work section.</p>") -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId) -%}
  {%- set buildDate = params.buildDate -%}
  {%- set industries = params.projects | groupBy("industry") | default([]) -%}

  {# TODO: Resolve background image path in production #}
  {%- set section = {
    base: "text-neutral-200",
    "motion-reduced": ""
  } %}

  {%- set header = {
  base: "content-end grid grid-cols-1 gap-8"} -%}

  {%- set title = {
    base: "col-span-full basis-full text-neutral-100 font-display font-light text-5xl",
    md: "text-6xl",
    lg: "text-7xl"
  } -%}

  {%- set nav = {
    print: "hidden",
    base: "w-full sticky top-8 z-10 bg-slate-950 shadow-[0px_4px_8px_0px_rgba(0,_0,_0,_0.25)]",
    sm: ""
  } -%}

  {%- set sub = {
    "base": "[&>p]:text-2xl [&>p]:font-thin lg:[&>p]:text-3xl"
  } %}

  <section id="{{ sectionId }}" class="{{ section |classes }} " aria-labelledby="{{ headingId }}" data-scroll-section>

    <header data-projects-el="header" class="{{ header | classes }} {{ sub | classes }}">
      <h2 id="{{ headingId }}" data-projects-el="heading" class="{{ title | classes }}">{{ heading }}</h2>
      {{ subheading | safe }}
    </header>

    {#- Display the industry links for jump navigation within the section -#}
    <nav id="work-jumplinks" aria-label="Jump to an industry" data-projects-el="jumplinks" class="{{ nav | classes }}">
      {{ Industries.render({ industries: industries }) }}
    </nav>

    {#- Display the industry groups and their projects -#}
    {% for industryTitle, projects in industries %}
      {% if projects | length %}
        {{ IndustrySection.render({ industryTitle: industryTitle, projects: projects }) }}
      {% endif %}
    {% endfor %}

  </section>
{% endmacro %}