{% macro render(params = {}) %}
  {% import "molecules/section-cap.njk" as SectionCap %}
  {% import "molecules/card/project.njk" as Card %}
  {% import "molecules/list/industry-links.njk" as Industries %}
  {% import "molecules/section/industry-section.njk" as IndustrySection %}
  {% import "atoms/icon.njk" as Icon %}

  {%- set sectionId = params.id | default("work") -%}
  {%- set classes = params.classes | default("") -%}
  {%- set heading = params.copy.heading | default("Work") -%}
  {%- set subheading = params.copy.subheading | default("") -%}
  {%- set body = params.copy.body | default("") -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId ~ "-heading") -%}
  {%- set buildDate = params.buildDate -%}
  {%- set industries = params.projects | groupBy("industry") | default([]) -%}

  {%- set section = {
    "base": "pl-12 relative text-primary-100",
    "motion-reduced": "",
    "lg": "pl-48"
  } %}

  {%- set header = {
  base: "sticky top-10 bg-slate-950 h-auto overflow-hidden z-20 p-6 space-y-6"} -%}

  {%- set title = {
    base: "col-span-full basis-full text-neutral-100 font-display font-light text-6xl",
    md: "text-7xl",
    lg: "text-8xl"
  } -%}

  {%- set nav = {
    base: "text-primary-200 border-t-2 border-slate-600 border-dotted p-4",
    sm: "border-t-3"
  } -%}

  <section id="{{ sectionId }}" class="{{ section |classes }} " aria-labelledby="{{ headingId }}" data-scroll-section>
    {{ SectionCap.render({title: "work" , count: order, buildDate: buildDate}) }}
    <header data-projects-el="header" class="{{ header | classes }}">
      <div class="flex items-center justify-between gap-4">
        <h2 id="{{ headingId }}" data-projects-el="heading" class="{{ title | classes }}">{{ heading }}</h2>
        {% if industries | length %}
          <button
            type="button"
            data-projects-el="nav-toggle"
            aria-expanded="false"
            aria-controls="work-jumplinks"
            class="group md:hidden shrink-0 p-2 rounded-md text-primary-200 transition-colors hover:text-neutral-50
              focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500">
            <span class="sr-only">Toggle industry list</span>
            {{ Icon.render({ name: "chevron-down", size: "lg", class: "group-aria-[expanded=true]:hidden" }) }}
            {{ Icon.render({ name: "chevron-up", size: "lg", class: "hidden group-aria-[expanded=true]:block" }) }}
          </button>
        {% endif %}
      </div>
      {% if industries | length %}
        <nav id="work-jumplinks" aria-label="Jump to an industry" data-projects-el="jumplinks" class="{{ nav | classes }}">
          {{ Industries.render({ industries: industries }) }}
        </nav>
      {% endif %}
    </header>
    {% if industries | length %}
      {% set industryHeadingIndex = 0 %}
      {% for industryTitle, projects in industries %}
        {% if projects | length %}
          {% set industryHeadingIndex = industryHeadingIndex + 1 %}
          {% set industryLabelIndex = industryHeadingIndex %}
          {% if industryHeadingIndex < 10 %}
            {% set industryLabelIndex = "0" ~ industryHeadingIndex %}
          {% endif %}
          {{ IndustrySection.render({ industryTitle: industryTitle, industryLabelIndex: industryLabelIndex, projects: projects }) }}
        {% endif %}
      {% endfor %}
    {% else %}
      <p class="col-span-full">No projects found.</p>
    {% endif %}
  </section>
{% endmacro %}