{% macro render(params = {}) %}
  {% import "molecules/list/project-cards.njk" as ProjectCards %}
  {% import "molecules/list/industry-links.njk" as Industries %}
  {% import "molecules/section/industry-section.njk" as IndustrySection %}

  {%- set sectionId = params.id | default("work") -%}
  {%- set classes = params.classes | default("") -%}
  {%- set heading = params.copy.heading | default("Work") -%}
  {%- set body = params.copy.body | default("<p>Oh noes! Content missing for the work section.</p>") -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId) -%}
  {%- set buildDate = params.buildDate -%}
  {%- set industries = params.projects | groupBy("industry") | default([]) -%}

  {%- set groupProjects = params.groupProjects | default(false) -%}

  {%- set section = {"base": "[&>p]:prose [&>p]:text-neutral-200 [&>p]:mx-4"} -%}

  {%- set header = {"base": "content-end grid grid-cols-1 px-4"} -%}

  {%- set title = {
    "base": "col-span-full basis-full text-neutral-100 font-display font-light text-5xl",
    "md": "text-6xl",
    "lg": "text-7xl"
  } -%}

  {%- set nav = {
    "print": "hidden",
    "base": "w-full sticky top-8 z-10 bg-slate-950 shadow-[0px_4px_8px_0px_rgba(0,_0,_0,_0.25)]",
    "sm": ""
  } -%}

  <section id="{{ sectionId }}"
           class="{{ section |classes }} "
           aria-labelledby="{{ headingId }}"
           data-scroll-section>

    <header data-projects-el="header" class="{{ header | classes }}">
      <h2 id="{{ headingId }}"
          data-projects-el="heading"
          class="{{ title | classes }}">{{ heading }}</h2>
    </header>
    {{ ProjectCards.render({ projects: params.projects, classes: "w-full" }) }}
  </section>
{% endmacro %}
