{% macro render(params = {}) %}
  {% import "atoms/organization.njk" as Organization %}
  {% import "atoms/button.njk" as Button %}

  {%- set sectionId = params.id | default("organizations") -%}
  {%- set heading = params.copy.heading | default("Organizations") -%}
  {%- set subheading = params.copy.subheading -%}
  {%- set body = params.copy.body -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId) -%}

  {%- set organizations = params.organizations | default([]) -%}

  {#- Row order and labels mirror the `organizationType` options in the Sanity
      schema (backend/schemaTypes/documents/content/organization.ts). Untyped
      organizations fall into a trailing "Other" row so none are dropped. -#}
  {%- set types = [
    {"value": "corporate", "label": "Corporate"},
    {"value": "nonprofit", "label": "Non-profit"},
    {"value": "government", "label": "Government"},
    {"value": "academic", "label": "Academic"},
    {"value": "startup", "label": "Startup"},
    {"value": "agency", "label": "Agency"}
  ] -%}
  {%- set typeValues = [] -%}
  {%- set rows = [] -%}
  {%- for type in types -%}
    {%- set typeValues = (typeValues.push(type.value), typeValues) -%}
    {%- set members = [] -%}
    {%- for organization in organizations -%}
      {%- if organization.organizationType == type.value -%}
        {%- set members = (members.push(organization), members) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if members | length -%}
      {%- set rows = (rows.push({"value": type.value, "label": type.label, "members": members}), rows) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set untyped = [] -%}
  {%- for organization in organizations -%}
    {%- if not (organization.organizationType in typeValues) -%}
      {%- set untyped = (untyped.push(organization), untyped) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if untyped | length -%}
    {%- set rows = (rows.push({"value": "other", "label": "Other", "members": untyped}), rows) -%}
  {%- endif -%}

  {%- set sectionStyles = {
    "base": "w-full max-w-screen-lg mx-auto text-neutral-100 relative z-10 col-span-full overflow-hidden px-4",
    "sm": "px-8",
    "md": "px-12",
    "lg": "px-24"
  } -%}
  {%- set header = {"base": "gap-2 py-12 z-10 w-full border-y border-neutral-600 divide-neutral-600 flex flex-row items-center"} -%}

  {%- set title = {
    "base": "col-span-full basis-full text-neutral-100 font-display font-light text-5xl",
    "md": "text-6xl",
    "lg": "text-7xl"
  } -%}

  {%- set groupStyles = {
    "base": "flex flex-col gap-3",
    "md": "flex-row items-center gap-8"
  } -%}
  {%- set typeStyles = {
    "base": "shrink-0 font-display text-sm uppercase tracking-wider text-neutral-400",
    "md": "w-32"
  } -%}

  {#- Static wrapped grid by default (no JS, reduced motion, or a row that
      already fits). OrganizationsAnimations sets `data-marquee` on a track
      only when its row overflows, switching it to a single scrolling line. -#}
  {%- set trackStyles = "flex flex-wrap data-marquee:flex-nowrap data-marquee:w-max data-marquee:will-change-transform" -%}

  <section id="{{ sectionId }}"
           class="{{ [sectionStyles, params.classes] | classes }}"
           aria-labelledby="{{ headingId }}"
           data-scroll-section>

    <header data-organizations-el="header" class="{{ header | classes }}">
      <h2 id="{{ headingId }}"
          data-organizations-el="heading"
          class="{{ title | classes }}">{{ heading }}</h2>
      <p data-organizations-el="body" class="col-span-full">{{ body }}</p>
    </header>
    {% if rows | length %}
      {#- Revealed by OrganizationsAnimations only while a marquee runs:
          WCAG 2.2.2 requires a way to pause motion that lasts over 5s. -#}
      {{ Button.render({
        "label": "Pause motion",
        "variant": "dark",
        "classes": "ml-auto mt-6 block text-sm",
        "attrs": 'hidden aria-pressed="false" data-organizations-el="toggle"'
      }) }}
      <ul data-organizations-el="list" class="col-span-full flex flex-col gap-8 py-12">
        {% for row in rows %}
          {%- set typeId = sectionId ~ "-" ~ row.value -%}
          <li data-organizations-el="group" class="{{ groupStyles | classes }}">
            <h3 id="{{ typeId }}"
                data-organizations-el="type"
                class="{{ typeStyles | classes }}">{{ row.label }}</h3>
            {#- <div>: a non-semantic clipping box for the moving track; no
                sectioning or landmark element fits. -#}
            <div data-organizations-el="viewport" class="min-w-0 flex-1 overflow-hidden">
              <ul data-organizations-el="track"
                  aria-labelledby="{{ typeId }}"
                  class="{{ trackStyles }}">
                {% for organization in row.members %}
                  <li data-organizations-el="organization" class="shrink-0 pr-3 pb-3">{{ Organization.render(organization) }}</li>
                {% endfor %}
              </ul>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="col-span-full">No organizations found.</p>
    {% endif %}
  </section>
{% endmacro %}
