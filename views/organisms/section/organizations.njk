{% macro render(params = {}) %}
  {% import "atoms/organization.njk" as Organization %}

  {%- set sectionId = params.id | default("organizations") -%}
  {%- set classes = params.classes | default("") -%}
  {%- set heading = params.copy.heading | default("Organizations") -%}
  {%- set subheading = params.copy.subheading -%}
  {%- set body = params.copy.body -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId) -%}

  {%- set organizations = params.organizations | default([]) -%}

  {%- set section = {"base": "w-full max-w-screen-lg mx-auto text-neutral-100 relative z-10 col-span-full overflow-hidden"} -%}
  {%- set header = {"base": "gap-2 py-12 z-10 w-full border-y border-slate-600 divide-neutral-600 flex flex-row items-center"} -%}

  {%- set title = {
    "base": "col-span-full basis-full text-neutral-100 font-display font-light text-5xl",
    "md": "text-6xl",
    "lg": "text-7xl"
  } -%}

  <section id="{{ sectionId }}"
           class="{{ section | classes }}"
           aria-labelledby="{{ headingId }}"
           data-scroll-section>

    <header data-organizations-el="header" class="{{ header | classes }}">
      <h2 id="{{ headingId }}"
          data-organizations-el="heading"
          class="{{ title | classes }}">{{ heading }}</h2>
      <p data-organizations-el="body" class="col-span-full">{{ body }}</p>
    </header>
    {% if organizations | length %}
      <ul data-organizations-el="list" class="col-span-full columns-2 gap-1">
        {% for organization in organizations %}
          <li data-organizations-el="organization">{{ Organization.render(organization) }}</li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="col-span-full">No organizations found.</p>
    {% endif %}
  </section>
{% endmacro %}
