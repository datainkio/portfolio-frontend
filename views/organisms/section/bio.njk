{% macro render(params = {}) %}
  {% import "molecules/printmarks.njk" as PrintMarks %}
  {%- set sectionId = params.id | default("bio") -%}
  {%- set classes = params.classes | default("") -%}
  {%- set heading = params.copy.heading -%}
  {%- set subheading = params.copy.subheading -%}
  {%- set body = params.copy.body -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId ~ "-heading") -%}
  {%- set buildDate = params.buildDate -%}

  {%- set section = {
    "base": "relative text-primary-100 col-span-full"
  } %}
  {% set header = {
    "base": "z-1 place-self-start p-4 my-6",
    "lg": "col-span-2 border-r-2 border-r-slate-700"
  } %}
  {%- set title = {
    "base": "basis-full font-display font-light text-4xl my-12",
    "sm": "text-6xl"
  } %}

  {%- set aside = {
    "base": "text-md font-display text-neutral-400 content-start space-y-12 px-4"
  } %}

  <section class="{{ section | classes }}" id="{{ sectionId }}" aria-labelledby="{{ headingId }}" data-scroll-section>
    <header class="{{ header | classes }}" data-bio-el="header">
      <p class="font-display text-neutral-400 w-full">A Design Philosophy</p>
      <h2 class="{{ title | classes }}" id="{{ headingId }}" data-bio-el="heading">{{ heading }}</h2>
      <p class="text-xl font-display text-secondary-500 w-full">Experience Designer + Creative Technologist</p>
    </header>
    <aside class="{{ aside | classes }}" data-bio-el="aside">
      <h3 class="arrow-prefix font-display text-neutral-400 border-b-2 border-neutral-400 border-dotted pb-3 mb-3">Focus Areas</h3>
      <ul class="pl-6">
        <li>UX Strategy</li>
        <li>Interaction Design</li>
        <li>Information Architecture</li>
        <li>Research + Insight</li>
      </ul>
      <h3 class="arrow-prefix font-display text-neutral-400 border-b-2 border-neutral-400 border-dotted pb-3 mb-3 ">
        Core Beliefs</h3>
      <ul class="pl-6">
        <li>Everyone deserves equitable access to goods and services</li>
        <li>Design should be inclusive and accessible</li>
        <li>Collaboration drives innovation</li>
        <li>Details mattere</li>
      </ul>
    </aside>
  </section>
{% endmacro %}