{% macro render(params = {}) %}
  {% import "molecules/printmarks.njk" as PrintMarks %}
  {%- set sectionId = params.id | default("bio") -%}
  {%- set classes = params.classes | default("") -%}
  {%- set heading = params.copy.heading -%}
  {%- set subheading = params.copy.subheading -%}
  {%- set body = params.copy.body -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId) -%}
  {%- set buildDate = params.buildDate -%}

  {%- set section = {
    "base": "relative pb-12 text-neutral-200 col-span-full content-center grid grid-cols-3 gap-6 px-4",
    "lg": "[&>p]:col-span-2"
  } %}
  {% set header = {
    "base": "z-1 place-self-start my-6 font-display col-span-full",
    "lg": "col-span-2"
  } %}
  {%- set title = {
    "base": "font-display text-5xl/12 my-12 tracking-loose",
    "sm": "text-6xl/16",
    "md": "text-7xl",
    "lg": "text-5xl/12"
  } %}
  {%- set copy = {
    "base": "[&>p]:col-span-full [&>p]:font-thin lg:[&>p]:font-light [&>p]:text-2xl [&>p]:px-0 [&>p]:mb-6",
    "lg": "[&>p]:text-3xl"
  } %}

  {%- set aside = {
    "base": "text-xl font-display text-neutral-500 items-start grid grid-cols-1 col-span-full gap-x-4",
    "sm": "grid-cols-2 grid-flow-col grid-rows-[auto_auto]",
    "lg": "items-start row-span-2 row-start-1 col-span-1 col-start-3 grid-cols-1 grid-flow-row gap-x-0"
  } %}
  {%- set asideHeading = {
    "base": "arrow-prefix text-neutral-400 border-b-2 border-neutral-400 border-dotted",
    "sm": "border-b-0 border-t-2"
  } %}

  <section class="{{ section | classes }} {{ copy | classes }}" id="{{ sectionId }}" aria-labelledby="{{ headingId }}" data-scroll-section>
    <header class="{{ header | classes }}" data-bio-el="header">
      <p class="font-display text-neutral-400 w-full" data-bio-el="context">A Design Philosophy</p>
      <h2 class="{{ title | classes }}" id="{{ headingId }}" data-bio-el="heading">{{ heading }}</h2>
      <p class="text-xl font-display text-secondary-500 w-full" data-bio-el="subheading">{{ subheading }}</p>
    </header>
    {{ body | safe }}
    <aside class="{{ aside | classes }}" data-bio-el="aside">
      <h3 class="{{ asideHeading | classes }}">
        Focus Areas</h3>
      <ul class="pl-6 text-sm self-start mb-12">
        <li>UX Strategy</li>
        <li>Interaction Design</li>
        <li>Information Architecture</li>
        <li>Research + Insight</li>
      </ul>
      <h3 class="{{ asideHeading | classes }}">
        Core Beliefs</h3>
      <ul class="pl-6 text-sm self-start mb-6">
        <li>Everyone deserves equitable access to goods and services</li>
        <li>Design should be inclusive and accessible</li>
        <li>Collaboration drives innovation</li>
        <li>Details matte<span class="inline-block -scale-x-100">r</span>
        </li>
      </ul>
    </aside>
  </section>
{% endmacro %}