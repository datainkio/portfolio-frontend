{% macro render(params = {}) %}
  {% import "molecules/printmarks.njk" as PrintMarks %}
  {% import "atoms/svg/blockframe-basic.njk" as BlockframeBasic %}
  {%- set sectionId = params.id | default("bio") -%}
  {%- set classes = params.classes | default("") -%}
  {%- set heading = params.copy.heading -%}
  {%- set subheading = params.copy.subheading -%}
  {%- set body = params.copy.body -%}
  {%- set order = params.order | default("") -%}
  {%- set headingId = params.headingId | default(sectionId) -%}
  {%- set buildDate = params.buildDate -%}

  {%- set section = {
    "base": "relative pb-12 text-neutral-200 col-span-full content-center grid grid-cols-12 gap-8 px-8 [&>p]:col-span-full [&>p]:prose [&>p]:text-2xl/8 [&>p]:text-neutral-200 md:[&>p]:col-span-7"
  } %}
  {% set header = {"base": "h-dvh flex flex-col justify-between z-1 pt-6 pb-48 font-display col-span-full"} %}
  {%- set title = {
    "base": "font-display text-5xl/12 my-12 tracking-loose",
    "sm": "text-6xl/16",
    "md": "text-7xl",
    "xl": "text-8xl/22"
  } %}
  {%- set aside = {
    "base": "items-center col-span-9 text-xl font-display text-neutral-400 content-start items-start grid grid-cols-1 gap-x-4",
    "md": "col-start-8 col-span-5",
    "xl": "col-start-9 col-span-4"
  } %}
  {%- set asideHeading = {"base": "mb-4 arrow-prefix text-neutral-400 border-b-2 border-neutral-400 border-dotted", "sm": ""} %}

  <section class="{{ section | classes }} {{ copy | classes }}"
           id="{{ sectionId }}"
           aria-labelledby="{{ headingId }}"
           data-scroll-section>
    <header class="{{ header | classes }}" data-bio-el="header">
      <p class="font-display text-neutral-400 w-full" data-bio-el="context">A Design Philosophy</p>
      <h2 class="{{ title | classes }}"
          id="{{ headingId }}"
          data-bio-el="heading">{{ heading }}</h2>
      <p class="place-self-end text-xl font-display text-secondary-500 w-full"
         data-bio-el="subheading">{{ subheading }}</p>
    </header>
    {{ body | safe }}
    <aside class="{{ aside | classes }}" data-bio-el="aside">
      <h3 class="{{ asideHeading | classes }}">Focus Areas</h3>
      <ul class="pl-10 text-sm self-start mb-6">
        <li>UX Strategy</li>
        <li>Interaction Design</li>
        <li>Information Architecture</li>
        <li>Research + Insight</li>
      </ul>
      <h3 class="{{ asideHeading | classes }}">Core Beliefs</h3>
      <ul class="pl-10 text-sm self-start">
        <li>Everyone deserves equitable access to goods and services</li>
        <li>Design should be inclusive and accessible</li>
        <li>Collaboration drives innovation</li>
        <li>
          Details matte<span class="inline-block -scale-x-100">r</span>
        </li>
      </ul>
    </aside>
    <div class="col-span-full md:col-span-7" data-bio-el="blockframes" aria-hidden="true">
      {{ BlockframeBasic.render({ classes: "w-full h-auto text-neutral-400" }) }}
    </div>
  </section>
{% endmacro %}
