{#
FOOTER LAYOUT ORGANISM
Reusable footer macro for consistent site-wide footer rendering.
Part of layout organism category for consistent page structure.
#}
{% import "organisms/navigation/primary-nav.njk" as primary_nav %}
{% import "molecules/list/social-accounts-list.njk" as social_accounts %}

{#- CONTAINER LAYOUT AND COLOR -#}
{%- set classes = {
  "base": "global-footer px-4 py-4 text-primary-200 bg-neutral-900 inner-border font-display text-primary-200 grid grid-cols-12"
} -%}

{#- SITE NAVIGATION STYLES -#}
{%- set navStyles = {"base": "col-span-full border-b border-neutral-700 pb-2 mb-2"} -%}

{#- SOCIAL ACCOUNTS -#}
{%- set socialStyles = {"base": "w-full mt-2 justify-center content-center col-span-9 border-r border-neutral-700"} -%}

{#- COPYRIGHT STYLES -#}
{%- set copyrightStyles = {
  "base": "mx-auto text-center justify-center col-span-3 text-sm text-primary-600 text-right inline-block my-auto"
} -%}

{% macro render(params = {}) %}
  {% set cms = params.cms %}
  {% set contact = (cms and cms.contact and cms.contact[0]) or {} %}
  {% set cmsNavigation = (cms and cms.navigation and cms.navigation[0]) or {} %}
  {% set footerItems = cmsNavigation.footerItems or [] %}
  {#- Site-global contact form. Wrapped in a 12-col grid so the section's
        `grid-cols-subgrid` has a parent grid outside of #page-main. -#}
  <footer class="{{ [classes, params.classes] | classes }}">
    {#- MAIN NAVIGATION -#}
    {{ primary_nav.render({ classes: navStyles | classes, items: footerItems, pages: params.pages, currentUrl: params.currentUrl }) }}
    {{ social_accounts.render({ accounts: contact.socialAccounts, classes: socialStyles }) }}
    <span class="{{ copyrightStyles | classes }}">© {{ params.year }} DIIO</span>
  </footer>
{% endmacro %}
