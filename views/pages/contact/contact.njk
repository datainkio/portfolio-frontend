{% extends "templates/landing/landing.njk" %}
{% import "organisms/forms/contact-form.njk" as contact_form %}
{% import "molecules/list/social-accounts-list.njk" as social_accounts with context %}
{% import "atoms/svg/email.njk" as email_icon %}
{% import "atoms/svg/location.njk" as location_icon %}
{% import "atoms/svg/globe.njk" as social_icon %}

{% set ulStyles = {"base": "col-span-full w-full text-primary-200 font-display grid grid-cols-6 max-w-md"} %}
{% set liStyles = {"base": "flex items-start col-span-full grid grid-cols-subgrid"} %}
{% set iconStyles = {"base": "size-10 m-4"} %}
{% set valueStyles = {"base": "col-span-5 text-primary-400 py-2 px-4 not-italic border-l h-full"} %}
{% set formStyles = {
  "base": "col-span-full grid grid-cols-subgrid",
  "lg": "col-span-6 col-start-7 row-start-1 row-span-3 self-center"
} %}

{% block content %}
  {{ super() }}
  <ul class="{{ ulStyles | classes }}">
    <li class="{{ liStyles | classes }}">
      {{ email_icon.render({"styles": iconStyles | classes}) }}
      <address class="{{ valueStyles | classes }} content-center">
        <span class="block text-xs text-neutral-400">Email</span>
        <a class="text-primary-400" href="mailto:{{ mailto }}">{{ mailto }}</a>
      </address>
    </li>
    <li class="{{ liStyles | classes }} border-y">
      {{ location_icon.render({"styles": iconStyles | classes}) }}
      <address class="{{ valueStyles | classes }} content-center">
        <span class="block text-xs text-neutral-400">Based In</span>
        <span class="text-primary-400">{{ location }}</span>
      </address>
    </li>
    <li class="{{ liStyles | classes }}">
      {{ social_icon.render({"styles": iconStyles | classes}) }}
      {{ social_accounts.render({"classes": valueStyles | classes ~ " content-start grid grid-cols-3"}) }}
    </li>
  </ul>
  {{ contact_form.render({"formStyles": formStyles | classes, "docNo": docNo, "docTitle": eleventyNavigation.title}) }}
  {% include "templates/partials/choreography-script/choreography-script.njk" %}
{% endblock content %}
