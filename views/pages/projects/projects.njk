{% extends "templates/landing/landing.njk" %}
{% import "molecules/list/industry-links.njk" as Industries %}
{% import "molecules/section/industry-section.njk" as IndustrySection %}
{%- set jumplinks = {
  "print": "hidden",
  "base": "w-full sticky top-8 z-10 bg-slate-950 shadow-[0px_4px_8px_0px_rgba(0,_0,_0,_0.25)]",
  "sm": ""
} -%}

{% block content %}
  {{ super() }}
  {% if collections.projects and collections.projects.length %}
    {%- set industries = collections.projects | groupBy("industry") | dictsort -%}
    <section id="work" class="col-span-full" data-scroll-section>
      <header data-projects-el="header">
        <nav data-projects-el="jumplinks"
             id="work-jumplinks"
             aria-label="Jump to an industry"
             class="{{ jumplinks | classes }}">
          {{ Industries.render({ industries: industries }) }}
        </nav>
      </header>
      {%- for industryTitle, industryProjects in industries -%}
        {{ IndustrySection.render({ industryTitle: industryTitle, projects: industryProjects }) }}
      {%- endfor -%}
    </section>
  {% else %}
    <p>No projects found.</p>
  {% endif %}
  {% include "templates/partials/choreography-script.njk" %}
  <script type="module" src="/assets/js/layouts/work-landing-header.js"></script>
{% endblock content %}
