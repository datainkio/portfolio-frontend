{% extends "templates/landing/landing.njk" %}
{% import "molecules/list/industry-links.njk" as Industries %}
{% import "molecules/section/industry-section.njk" as IndustrySection %}
{%- set headerStyles = {"print": "hidden", "base": "fixed left-0 z-10 flex flex-col justify-center w-56", "md": "top-0 h-dvh"} -%}

{%- set navStyles = {"base": "w-full shadow-[0px_4px_8px_0px_rgba(0,_0,_0,_0.25)]"} -%}
{%- set drawerToggleStyles = {
  "base": "md:hidden absolute top-1/2 -right-10 -translate-y-1/2 flex h-10 w-10 items-center justify-center bg-slate-950 text-primary-200 shadow-[0px_4px_8px_0px_rgba(0,_0,_0,_0.25)]"
} -%}

{% block mainStyles %}
  {{ { "base": "mx-auto my-8 grid grid-cols-12 gap-x-8", "md": "pl-64" } | classes }}
{% endblock mainStyles %}

{% block content %}
  {{ super() }}
  {% if collections.projects and collections.projects.length %}
    {%- set industries = collections.projects | groupBy("industry") | dictsort -%}
    <section id="work" class="col-span-full" data-scroll-section>
      <header data-projects-el="header" class="{{ headerStyles | classes }}">
        <nav data-projects-el="jumplinks"
             id="work-jumplinks"
             aria-label="Jump to an industry"
             class="{{ navStyles | classes }}">
          <button type="button"
                  data-projects-el="drawer-toggle"
                  aria-expanded="false"
                  aria-controls="work-jumplinks"
                  aria-label="Toggle industry navigation"
                  class="{{ drawerToggleStyles | classes }}">
            <span aria-hidden="true">&#9776;</span>
          </button>
          {{ Industries.render({ industries: industries }) }}
        </nav>
      </header>
      {%- for industryTitle, industryProjects in industries -%}
        {{ IndustrySection.render({ industryTitle: industryTitle, projects: industryProjects }) }}
      {%- endfor -%}
    </section>
  {% else %}
    <p>No projects found.</p>
  {% endif %}
{% endblock content %}
