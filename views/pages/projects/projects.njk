{% extends "templates/landing/landing.njk" %}
{% import "organisms/navigation/industry-nav/industry-nav.njk" as Industries %}
{% import "molecules/section/industry-section.njk" as IndustrySection %}

{#- Industries are needed by two blocks (the section list in `content`, the
    jump nav in `sidebarBefore`), so they're grouped once here at template level. -#}
{%- set industries = (collections.projects | groupBy("industry") | dictsort) if (collections.projects and collections.projects.length) else [] -%}


{% block mainStyles %}
  {#- isolate: contains the page video's -z-10 within <main>, so it slides
      beneath page content but never behind the page background. -#}
  {{ { "base": "isolate pb-24 mx-auto my-8 grid grid-cols-12 gap-x-8", "md": "pl-64", "lg": "relative" } | classes }}
{% endblock mainStyles %}

{#- Optional portrait page video (projects.pageVideo → videoAsset). The asset's
    poster is the only fallback this page has, so the video renders only when
    both are present. -#}
{%- set pageVideo = cms.projectsLanding[0].pageVideo if (cms.projectsLanding and cms.projectsLanding.length) else null -%}
{%- set pageVideoSrc = pageVideo and (pageVideo.url or pageVideo.videoUrl) -%}
{%- set pageVideoPoster = pageVideo and pageVideo.poster and pageVideo.poster.url -%}

{#- The figure is the 9:16 frame. Its width cap holds its height to 100dvh
    (height = width × 16/9). It doesn't clip: the video scales past it from
    the top-right corner, growing left and down, and -z-10 keeps the overflow
    beneath the page content. -#}
{%- set videoFigureStyles = {
  "base": "-z-10 col-span-full justify-self-center w-full max-w-[calc(100dvh*9/16)] m-0 aspect-[9/16]",
  "lg": "absolute top-0 right-0 w-1/2"
} -%}
{#- scale-[…] sets how far the video extends past the frame. -#}
{%- set videoStyles = {"base": "w-full h-full object-cover object-center origin-top-right scale-[1.25]"} -%}

{% block content %}
  {{ super() }}
  {% if pageVideoSrc and pageVideoPoster %}
    <figure data-projects-el="video"
      class="{{ videoFigureStyles | classes }}">
      {#- Decorative, same contract as the card video (molecules/card/card.njk):
          hidden from AT, left posterized under reduced motion
          (`data-motion-optional`), and hydrated + played only near the
          viewport (`data-play-in-view`). -#}
      <video data-defer-video
             data-motion-optional
             data-src="{{ pageVideoSrc }}"
             poster="{{ pageVideoPoster | imageUrl({"w": 720}) }}"
             width="720"
             height="1280"
             class="{{ videoStyles | classes }}"
             {#- Optional alpha mask (videoAsset.mask): the PNG's alpha channel clips the video, stretched to its box, so it scales with the video. Masks poster and video alike. -#}
             {% if pageVideo.mask %}style="mask: url('{{ pageVideo.mask }}') center / 100% 100% no-repeat;"{% endif %}
             preload="none"
             aria-hidden="true"
             tabindex="-1"
             playsinline
             {% if pageVideo.muted != false %}muted{% endif %}
             {% if pageVideo.loop != false %}loop{% endif %}
             {% if pageVideo.autoplay != false %}data-play-in-view{% endif %}>
      </video>
    </figure>
  {% endif %}
  {% if industries | length %}
    <section id="work"
             class="col-span-full md:pt-8lg:relative lg:z-10 "
             data-scroll-section>
      {%- for industryTitle, industryProjects in industries -%}
        {{ IndustrySection.render({ industryTitle: industryTitle, projects: industryProjects }) }}
      {%- endfor -%}
    </section>
  {% else %}
    <p>No projects found.</p>
  {% endif %}
{% endblock content %}

{#- The industry jump nav precedes <main> in source order, so keyboard and
    screen-reader users reach the index before the content it indexes. Its
    fixed drawer/rail positioning is unaffected: sidebarBefore sits outside
    #page-main-content, like afterMain. -#}
{% block sidebarBefore %}
  {{ Industries.render(industries) }}
{% endblock sidebarBefore %}
