{# This is an atomic component for rendering headings (h1-h6) with customizable properties. It's super useful when you want to maintain proper semantic structure. Which you should always want to do. #}
{% macro render(params = {}) %}
  {% set level = params.level | default(2) %}
  {% set text = params.text %}
  {% set id = params.id | default(null) %}

  {% if level < 1 or level > 6 %}
    {% set level = 2 %}
  {% endif %}

  <h{{ level }} {% if id %} id="{{ id }}" {% endif %} {% if params.classes %} class="{{ params.classes | classes }}" {% endif %}>
    {{ text }}
  </h{{ level }}>
{% endmacro %}