{#
  Pixelator
  A simple overlay that adds a pixelated effect to its container. It is an
  absolutely positioned div that covers the container, with a pixelated
  background image and pointer-events set to none so interactions pass
  through it.
#}
{% macro render(params = {}) %}
  {%- set styles = {
    base: "absolute inset-0 bg-pixelator pointer-events-none"
  } 
  -%}
  <div class="{{ styles | classes }}"></div>
{% endmacro %}