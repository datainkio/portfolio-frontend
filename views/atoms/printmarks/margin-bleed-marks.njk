{% macro render(params = {}) %}
  {%- set color = params.color | default("white") -%}
  {#- The bleed line takes the shared color unless bleedColor is given. -#}
  {%- set bleedColor = params.bleedColor | default(color) -%}
  {%- set size = params.size | default("1") -%}
  {%- set bleedInset = params.bleedInset | default("8") -%}
  {%- set style = params.style | default("dashed") -%}
  {%- set marginInset = params.marginInset | default("6") -%}
  <div
    aria-hidden="true"
    class="absolute inset-{{ bleedInset }} border border-{{ size }} border-{{ bleedColor }} border-{{ style }}"></div>
  <div aria-hidden="true" class="absolute inset-{{ marginInset }} border border-{{ size }} border-{{ color }}"></div>
{% endmacro %}