{% macro render(params = {}) %}
  {% set entry = params.entry or {} %}
  {% set linkUrl = entry.url or entry.href or params.url or params.href %}
  {% set linkTitle = entry.pageNavLabel or entry.key or params.title %}
  {% set linkClasses = entry.class or (params.classes | classes) %}
  {% set isCurrent = (linkUrl == params.currentUrl) %}
  {% set linkDescription = entry.description or params.description %}

  <a href="{{ linkUrl }}"
     class="nav_link {{ linkClasses }} "
     {% if isCurrent %}aria-current="page"{% endif %}
     {% if linkDescription %}title="{{ linkDescription }}"{% endif %}>{{ linkTitle }}</a>
{% endmacro %}
