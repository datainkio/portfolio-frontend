{# Current Section Title - a simple text element that displays the id of its parent and its location with respect to its siblings. #}
{% macro render(params = {}) %}
  {%- set prefix = params.prefix | default("doc") -%}
  {%- set count = params.count | default("") -%}
  {%- set title = params.title | default("") -%}
  {%- set buildDate = params.buildDate -%}
  <span data-current-section-title class="text-secondary-500">{{ title }}</span>
  <span data-current-section-count>{{ prefix }}
    {{ count }}</span>
  <time class="text-neutral-400" datetime="{{ buildDate | formatDate("yyyy-MM-dd'T'HH:mm:ss'Z'") }}">{{ buildDate | formatDate("yyyy.MM.dd'T'HH:mm:ss'Z'") }}</time>
{% endmacro %}