{% import "molecules/list/build-info.njk" as BuildInfo with context %}
{% macro render(params = {}) %}
  {%- set prefix = params.prefix | default("doc") -%}
  {%- set count = params.count | default("") -%}
  {%- set title = params.title | default("") -%}
  {%- set cap = {
    base: "text-xs z-10 w-full col-span-full flex items-center px-6 border-b-2 border-b-slate-700 text-primary-200 bg-slate-950"
  } %}
  <ul data-buildinfo-el="cap" class="{{ cap | classes }} {{ params.classes }} group/cap">
    <li data-current-section-title class="text-secondary-500 justify-self-start basis-1/3 group-data-[open]/cap:basis-1/6">{{ title }}</li>
    <li data-current-section-count class="justify-self-center text-center basis-1/3 group-data-[open]/cap:basis-1/6">{{ prefix }}
      {{ count }}</li>
    <li class="basis-1/3 group-data-[open]/cap:basis-2/3">{{ BuildInfo.render() }}</li>
  </ul>
{% endmacro %}