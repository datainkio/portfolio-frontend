{% import "atoms/video/video.njk" as videoAtom %}
{% import "atoms/gel.njk" as Gel %}
{% import "atoms/pixelator.njk" as Pixelator %}
{% macro render(params = {}) %}
  {%- set bgID = params.id | default('sizzle-background') -%}
  {%- set containerClasses = ['fixed inset-0 -z-10 pointer-events-none overflow-hidden', params.classes] | classes -%}
  {%- set containerStyle = params.style | default('') -%}
  {%- set posterUrl = params.poster | imageUrl({w: 1020, q: 75}) | default('') -%}
  <div id="{{ bgID }}"
       style="{{ containerStyle }}"
       class="{{ containerClasses }}"
       aria-hidden="true"
       inert>
    {{ videoAtom.render({
        src: params.videoSrc,
        defer: false,
        poster: posterUrl,
        autoplay: params.autoPlay | default(true) ,
    loop: params.loop | default(true),
    muted: params.muted | default(true),
    playsInline: params.playsInline | default(true),
    preload: params.preload | default("metadata"),
    classes: "absolute inset-0 w-full h-full object-cover object-center pointer-events-none gsap-element gsap-fade",
    style: ""
    }) }}

    {{ Pixelator.render() }}
    {{ Gel.render({"id": "gel_hero", "fade": "gel-fade-lg", "opacityEnd": "gel-opacity-end-50"}) }}
    {{ Gel.render({"id": "gel_tagline", "fade": "gel-fade-lg", "opacityEnd": "gel-opacity-end-0"}) }}
    {# {{ Gel.render({"id": "gel_subheading", "color": "gel-primary"}) }}
    {{ Gel.render({"id": "gel_process", "color": "gel-primary"}) }}
    {{ Gel.render({"id": "gel_awards_backing", "color": "gel-accent"}) }}
    {{ Gel.render({"id": "gel_awards_tint", "color": "gel-accent"}) }} #}
  </div>
{% endmacro %}
