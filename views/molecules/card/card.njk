{% import "atoms/heading.njk" as HeadingBlock %}
{% import "atoms/cta.njk" as CTA %}
{% import "molecules/stats/stats.njk" as Details %}
{% macro render(params = {}) %}

  {#- Data guards -#}
  {%- set title = params.title -%}
  {%- set eyebrow_txt = params.eyebrow -%}
  {%- set headingLevel = params.headingLevel | default(3) -%}
  {%- set description_txt = params.description -%}
  {%- set byline_txt = params.byline -%}
  {%- set meta = params.meta | default([]) -%}
  {%- set featured = params.featured | default(false) -%}
  {%- set image = params.image -%}
  {%- set width = image and (image.width or image.asset.metadata.dimensions.width) -%}
  {%- set height = image and (image.height or image.asset.metadata.dimensions.height) -%}
  {%- set url = params.url -%}
  {%- set classes = params.classes -%}
  {%- set imageClasses = params.imageClasses -%}
  {%- set eager = params.eager | default(false) -%}
  {%- set imageSrc = image and (image.src or image.url or image.asset.url or image) -%}
  {%- set imageAlt = image and image.alt or title -%}

  {#- Optional card video. The still is never discarded: it supplies the poster
      frame, and remains the sole media for no-JS and reduced-motion visitors. -#}
  {%- set video = params.video -%}
  {%- set videoSrc = video and (video.url or video.videoUrl) -%}
  {%- set posterSrc = (video and video.poster and video.poster.url) or imageSrc -%}
  {%- set hasMedia = imageSrc or videoSrc -%}

  {#- Styling -#}

  {%- set root = {"base": "relative text-neutral-950 isolate w-full pb-[25dvh]", "lg": "p-4"} -%}

  {%- set figure = {"base": "bg-primary-900 m-0 z-0 overflow-hidden h-dvh", "lg": "h-auto aspect-video shadow-md"} -%}

  {%- set imageCSS = {"base": "w-full h-full object-cover object-center"} -%}

  {%- set body = {
    "base": "shadow-lg grid grid-cols-6 inner-border px-6 py-6 m-4 mb-8 relative z-10 content-start bg-neutral-100"
  } -%}

  {%- set eyebrow = {"base": "eyebrow text-xs uppercase tracking-wide col-span-full m-0", "lg": "text-sm"} -%}

  {%- set header = {"base": "header col-span-5 pb-2 pr-2 hover:no-underline border-dotted border-r-3 border-neutral-600"} -%}

  {%- set heading = {
    "base": "text-neutral-950 text-xl leading-6 font-display mt-1",
    "sm": "text-3xl",
    "md": "text-xl leading-6",
    "xl": "text-2xl leading-6"
  } -%}

  {%- set byline = {"base": "byline text-sm font-display"} -%}

  {%- set description = {"base": "sr-only col-span-full"} -%}

  {%- set stats = {"base": "col-span-full text-neutral-950 sr-only"} -%}

  {%- set footer = {"base": "my-auto px-4"} -%}

  {%- set linky = {"base": "font-serif text-2xl italic inline-block"} -%}

  <article data-card-el="root" class="{{ root | classes }} {{ classes }}">
    {% if hasMedia %}
      <figure data-card-el="figure" class="{{ figure | classes }}">
        {% if videoSrc %}
          {#- Decorative: the card heading carries the accessible name, so the
              video is hidden from AT. `data-motion-optional` tells the
              preloader to leave it unhydrated under prefers-reduced-motion,
              which leaves the poster standing in. -#}
          <video data-card-el="video"
                 data-defer-video
                 data-motion-optional
                 data-src="{{ videoSrc }}"
                 poster="{{ posterSrc }}"
                 width="{{ width }}"
                 height="{{ height }}"
                 class="{{ imageCSS | classes }} {{ imageClasses }}"
                 preload="none"
                 aria-hidden="true"
                 tabindex="-1"
                 playsinline
                 {% if video.muted != false %}muted{% endif %}
                 {% if video.loop != false %}loop{% endif %}
                 {% if video.autoplay != false %}autoplay{% endif %}>
          </video>
        {% else %}
          <img data-card-el="image"
               src="{{ imageSrc }}"
               alt="{{ imageAlt }}"
               width="{{ width }}"
               height="{{ height }}"
               class="{{ imageCSS | classes }} {{ imageClasses }}"
               loading="{{ 'eager' if eager else 'lazy' }}" />
        {% endif %}
      </figure>
    {% endif %}

    <div data-card-el="body" class="{{ body | classes }}">

      <header class="{{ header | classes }}">
        {% if byline_txt %}
          <p class="{{ eyebrow | classes }}">{{ byline_txt }}</p>
        {% endif %}
        {{ HeadingBlock.render({ level: headingLevel, text: title, class: (heading | classes) }) }}

      </header>

      {% if description_txt %}
        <p class="{{ description | classes }} font-body">{{ description_txt }}</p>
      {% endif %}
      {% if meta | length %}
        {{ Details.render({ stats: meta, classes: stats | classes }) }}
      {% endif %}

      <footer class="{{ footer | classes }}">
        {% if url %}
          {{ CTA.render({ text: "View", url: url, classes: linky | classes }) }}
        {% endif %}
      </footer>

    </div>

  </article>
{% endmacro %}
