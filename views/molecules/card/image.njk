{% import "molecules/figure/media.njk" as Media %}
{#- Inner maps as variables: a nested literal ending in `}}` closes the tag early. -#}
{%- set pictureStyles = "block w-full h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:block" -%}
{%- set mediaStyles = {"image": pictureStyles, "caption": "mt-2 text-sm text-neutral-600"} -%}
<div class="rounded-lg bg-neutral-100 shadow-xl overflow-hidden">
  {{ Media.render({ picture: image.file.html, caption: image.title, zoom: true, classes: "contents", styles: mediaStyles }) }}
  <div class="px-4 py-4">
    <dl class="divide-y divide-neutral-200 shadow-sm rounded border border-neutral-200">
      <div class="flex justify-between px-3 py-2">
        <dt class="text-sm text-neutral-600">Filename</dt>
        <dd class="text-sm text-neutral-800">{{ image.file.originalFilename or "N/A" }}</dd>
      </div>
      <div class="flex justify-between px-3 py-2">
        <dt class="text-sm text-neutral-600">Type</dt>
        <dd class="text-sm text-neutral-800">{{ image.type or "Unknown" }}</dd>
      </div>
      <div class="flex justify-between px-3 py-2">
        <dt class="text-sm text-neutral-600">ID</dt>
        <dd class="text-sm text-neutral-800">{{ image.id }}</dd>
      </div>
      <div class="flex justify-between px-3 py-2">
        <dt class="text-sm text-neutral-600">Dimensions</dt>
        <dd class="text-sm text-neutral-800">
          {{ image.width or "?" }}x{{ image.height or "?" }}
        </dd>
      </div>
    </dl>
  </div>
</div>
