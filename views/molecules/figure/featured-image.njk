{#
  params.styles: { figure, image, caption } — each a `classes` variant map
  (e.g. {"base": "...", "md": "..."}) or string. No styles are hard-coded here.
  params.zoom: true wraps the image in the lightbox contract
  (data-lightbox-el, see molecules/lightbox/lightbox.njk) — click to open a
  native <dialog>; cursor is the only affordance.
#}
{% macro render(params = {}) %}
  {%- set image = params.image or {} -%}
  {%- set styles = params.styles or {} -%}
  {%- set url = image.asset.url if image.asset else "" -%}
  {%- if url -%}
    {%- set dims = image.asset.metadata.dimensions if image.asset.metadata else {} -%}
    {%- set alt = image.alt | default(params.alt) | default('') -%}
    {%- set img -%}
      <img src="{{ url }}"
           alt="{{ alt }}"
           {% if dims.width and dims.height %}width="{{ dims.width }}" height="{{ dims.height }}"{% endif %}
           loading="{{ params.loading | default("eager") }}"
           decoding="async"
           class="{{ styles.image | classes }}" />
    {%- endset -%}
    <figure class="{{ styles.figure | classes }}"
            {% if params.zoom %}data-lightbox-el="root"{% endif %}
            {{ params.attrs | default("") | safe }}>
      {%- if params.zoom -%}
        <button type="button"
                data-lightbox-el="trigger"
                class="block w-full cursor-zoom-in"
                aria-haspopup="dialog"
                {% if not alt %}aria-label="Enlarge image"{% endif %}>{{ img | safe }}</button>
        <dialog data-lightbox-el="dialog"
                aria-label="{{ alt | default(image.caption) | default('Image viewer') }}"
                class="m-auto max-w-[90vw] max-h-[90vh] bg-transparent p-4 backdrop:bg-black/80 cursor-zoom-out">
          <button type="button"
                  data-lightbox-el="close"
                  class="mb-2 text-white bg-neutral-900 hover:bg-neutral-700 py-1 px-3 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">Close</button>
          <img src="{{ url }}"
               alt="{{ alt }}"
               loading="lazy"
               class="block max-w-[90vw] max-h-[75vh] object-contain cursor-auto" />
        </dialog>
      {%- else -%}
        {{ img | safe }}
      {%- endif -%}
      {%- if image.caption -%}
        <figcaption class="{{ styles.caption | classes }}">{{ image.caption }}</figcaption>
      {%- endif -%}
    </figure>
    {%- if params.zoom -%}
      <script type="module">import "/assets/js/lightbox/Lightbox.js";</script>
    {%- endif -%}
  {%- endif -%}
{% endmacro %}
