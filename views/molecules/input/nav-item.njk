{% import "atoms/link/link.njk" as Link %}
{% if item.children.length > 0 %}
  <li class="collapse collapse-plus md:collapse-open ">
    {#- Behavioral toggle, not a data input: DaisyUI's CSS-only accordion
        relies on a bare radio's :checked sibling-selector state. atoms/input.njk
        is a form-data primitive (type/placeholder) and doesn't fit this role,
        so this stays raw markup by design. -#}
    <input type="radio" name="{{ accordionName }}"/>
    <div class="collapse-title text-xl font-medium">{{ item.key }}</div>
    <ul class="collapse-content">
      <li class="pb-2 italic">
        {{ Link.render({ url: item.url, text: "Introduction" }) }}
      </li>
      {% for child in item.children %}
        <li>
          {{ Link.render({ url: child.url, text: child.key }) }}
        </li>
      {% endfor %}
    </ul>
  </li>
{% else %}
  <li class="collapse-title text-xl">
    {{ Link.render({ url: item.url, text: item.key }) }}
  </li>
{% endif %}