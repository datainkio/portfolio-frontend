{% import "atoms/link/link.njk" as Link %}
{% if item.children.length > 0 %}
  <li>
    {#- Native <details>/<summary> disclosure — accessible and keyboard-operable
        with no JS or extra markup. Replaces a prior DaisyUI radio+CSS accordion
        that depended on a library this project never installed. -#}
    <details open name="{{ accordionName }}" class="group">
      <summary class="text-xl font-medium cursor-pointer list-none flex items-center justify-between">
        {{ item.key }}
        <span class="text-sm transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
      </summary>
      <ul class="mt-2 ml-4">
        <li class="pb-2 italic">
          {{ Link.render({ url: item.url, text: "Introduction" }) }}
        </li>
        {% for child in item.children %}
          <li>
            {{ Link.render({ url: child.url, text: child.key }) }}
          </li>
        {% endfor %}
      </ul>
    </details>
  </li>
{% else %}
  <li class="text-xl font-medium">
    {{ Link.render({ url: item.url, text: item.key }) }}
  </li>
{% endif %}
