{% macro render(params = {}) %}
  {% import "molecules/figure/media.njk" as Media %}
  {% import "atoms/svg/inline.njk" as InlineSvg %}
  {% import "molecules/printmarks.njk" as Printmarks %}
  {%- set statement = params.statement -%}
  {%- set layout = params.layout | default("left") -%}

  {# Section statement component - displays a heading, body text, and media (image or video) #}

  {#- LAYOUT: "left" puts the text in the left columns and the figure flush right;
      "right" mirrors it (text in the right columns, figure flush left). Class strings
      stay literal so Tailwind's scanner finds them. -#}
  {%- set isRight = layout == "right" -%}

  {# SECTION STYLES (incl. responsive prose-p classes) -#}
  {%- set section_styles = {
    "base": "relative isolate min-h-dvh max-w-none grid grid-cols-12 content-center col-span-full prose prose-invert prose-p:text-xl prose-p:m-0",
    "md": "prose-p:drop-shadow-md/100"
  } -%}

  {#- BODY -#}
  {#- The paragraphs sit in one wrapper, which is a single grid item, so the figure beside it
      (lg) cannot stretch the rows between them. The wrapper is its own grid with the section's
      gap-y-4, so stacked paragraphs are 1rem apart at every breakpoint (their prose margins
      are zeroed on the section). Below md: one column. md: two columns side by side. lg: one
      column again, in the four columns opposite the figure, top-aligned with it. -#}
  {#- No figure: from md the paragraphs share one row across the full width, however many
      there are (column flow, equal columns), and lg keeps that instead of narrowing. -#}
  {%- if statement.image -%}
    {%- set body_styles = {
        "base": "col-span-full grid grid-cols-1 content-start gap-y-4 pb-8",
        "md": "grid-cols-2 gap-x-8",
        "lg": "col-span-4 col-start-9 grid-cols-1" if isRight else "col-span-4 col-start-1 grid-cols-1"
        } -%}
  {%- else -%}
    {%- set body_styles = {
      "base": "col-span-full grid grid-cols-1 content-start gap-y-4 pb-12",
      "md": "grid-cols-none grid-flow-col auto-cols-fr gap-x-8"
    } -%}
  {%- endif -%}

  {#- HEADING-#}
  {%- set heading_styles = {
    "base": "pb-0 font-display text-secondary-500 col-span-full drop-shadow-md/100",
    "sm": "text-4xl",
    "md": "col-span-10",
    "lg": "text-5xl"
  } -%}

  {#- MEDIA -#}
  {%- set caption_styles = {"base": "sr-only"} -%}
  {#- A portrait background behind the text, flush to the side opposite the text, full statement height.
      Primarily decorative in role. md+ takes the background video's rest pose (BACKGROUND_PERSPECTIVE:
      perspective = 1.25 × viewport width, rotateY(-15deg) about the edge it is flush to; mirrored for
      "right"), minus its scale(1.35), which only exists to fill the viewport. md+ also fades the art
      toward the centre of the view with a horizontal alpha mask (opaque at the flush edge, transparent
      at the text side), so it recedes behind the text and the text stays legible. -#}
  {%- set figure_styles = {
    "base": "not-prose relative col-span-full bg-page-graphpaper shadow-lg p-6",
    "md": "p-12 m-0 h-full w-full origin-left [transform:perspective(125vw)_rotateY(15deg)] border-l border-neutral-800" if isRight else "p-12 m-0 h-full w-full origin-right [transform:perspective(125vw)_rotateY(-15deg)] border-r border-neutral-800",
    "lg": "p-16 col-start-1 col-span-8 opacity-100 row-start-2" if isRight else "p-16 col-start-5 col-span-8 opacity-100 row-start-2"
    } -%}

  {%- set image_styles = {"base": "block h-full w-full"} -%}
  {#- Inline SVG: the figure gets a definite width (full below md, half from md) and the SVG fills
      that box, so the art scales to fit whole whatever its aspect ratio (preserveAspectRatio "meet"),
      aligned to the edge the figure is flush to. The raster path sizes by height instead, which
      pushes landscape art past the viewport edge. -#}
  {%- set svg_figure_styles = {
    "base": "not-prose relative col-span-full bg-page-graphpaper shadow-lg p-6",
    "md": "p-12 m-0 h-full w-full origin-left [transform:perspective(125vw)_rotateY(15deg)] border-l border-neutral-800" if isRight else "p-12 m-0 h-full w-full origin-right [transform:perspective(125vw)_rotateY(-15deg)] border-r border-neutral-800",
    "lg": "p-16 col-start-1 col-span-8 opacity-100 row-start-2" if isRight else "p-16 col-start-5 col-span-8 opacity-100 row-start-2"
    } -%}
  {%- set svg_styles = {"base": "block h-full w-full"} -%}
  {%- set svg_aspect = "xMinYMid meet" if isRight else "xMaxYMid meet" -%}
  {#- PRINT MARKS -#}
  {#- Press-proof marks laid over the figure's graph paper: ink bars and registration targets
      in the gutter, then the margin and bleed boxes and the trim corners stepping in toward
      the art. Light colours (primary-100, the graph paper's grid colour) so they read on
      neutral-950. Insets are measured from the figure's edge and are tuned to the inline-SVG
      figure, whose art sits 4rem in (the figure's p-8 plus the image wrapper's p-8). The
      figure is `relative`, so the marks tilt with it from md. -#}
  {%- set print_marks = Printmarks.render({
    inset: "4",
    trim: { color: "primary-100", size: "3", inset: "14", weight: "1" },
    marginBleed: { color: "primary-100/60", size: "1", style: "dashed", marginInset: "10", bleedInset: "12" }
    }) -%}
  <section class="{{ section_styles | classes }}"
           data-hero-el="mission-statement">

    {#- HEADING -#}
    {%- if statement.subheading %}
      <h2 class="{{ heading_styles | classes }}"
          data-hero-el="statement-heading">{{ statement.subheading }}</h2>
    {%- endif %}

    {#- BODY TEXT (HTML) -#}
    {% if statement.body %}
      <div class="{{ body_styles | classes }}">{{ statement.body | safe }}</div>
    {% endif %}

    {#- IMAGE (SVG or raster) -#}
    {% if statement.image and statement.imageInline %}
      {#- A prepared SVG (imageInline, fetched at build time by data/sanity/transforms/home.js)
          renders inline, fills intact, so Hero's choreography can reveal its top-level groups.
          It goes through Media's pre-rendered `picture` slot, keeping the same <figure>,
          sr-only caption, and image styles as the raster path. -#}
      {%- set svgMarkup = InlineSvg.render({ svg: statement.imageInline, alt: statement.image.alt or statement.subheading, classes: svg_styles, preserveAspectRatio: svg_aspect, preserveFills: true, attrs: 'data-hero-el="statement-svg"' }) -%}
      {{ Media.render({ image: statement.image, picture: svgMarkup, alt: statement.subheading, classes: svg_figure_styles, overlay: print_marks, styles: { "image": image_styles, "caption": caption_styles } }) }}
    {% elif statement.image %}
      {{ Media.render({ image: statement.image, alt: statement.subheading, loading: "lazy", classes: figure_styles, overlay: print_marks, styles: { "image": image_styles, "caption": caption_styles } }) }}
    {% endif %}
  </section>
{% endmacro %}
