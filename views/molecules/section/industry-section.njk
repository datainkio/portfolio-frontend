{% import "molecules/list/project-cards.njk" as ProjectCards %}
{% macro render(params = {}) %}
  {%- set section = {"base": "grid grid-cols-1 items-start my-48"} -%}
  {#- hyphens-auto + break-words: single long words ("Uncategorized",
      "Documentary") overflow the narrow column at text-5xl. Overflow widens
      the mobile layout viewport, which pushes fixed UI such as the industry
      drawer below the visible screen. -#}
  {%- set heading = {"base": "font-display text-5xl pl-2 mb-12 hyphens-auto break-words", "md": "pt-24"} -%}
  {%- set projects = {"base": "w-full"} -%}
  <section data-projects-el="industry-group"
           class="{{ section | classes }}"
           aria-labelledby="{{ params.industryTitle | slugify }}">
    <h3 id="{{ params.industryTitle | slugify }}"
        class="{{ heading | classes }}"
        data-projects-el="industry-heading">{{ params.industryTitle }}</h3>
    {{ ProjectCards.render({ projects: params.projects, classes: projects | classes }) }}
  </section>
{% endmacro %}
