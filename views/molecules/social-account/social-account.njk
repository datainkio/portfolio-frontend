{#-
Social Account Molecule
Renders one socialAccount object (title, logo, url) as an external profile link.
Params: account { title, logo.url, url }, classes
-#}
{% import "atoms/svg/inline.njk" as InlineSvg %}

{%- macro render(params = {}) -%}

  {#- DATA GUARDS -#}
  {%- set account = params.account -%}
  {%- set format = params.format | default("icon") -%}

  {#- STYLES -#}
  {%- set linkClasses = {"base": "inline-flex items-center justify-center", "sm": params.classes} -%}
  {%- set logoClasses = {"base": "h-full w-full object-contain"} -%}

  {#- DISPLAY -#}
  {%- if account and account.url -%}
    <a href="{{ account.url }}"
       class="{{ linkClasses | classes }}"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="{{ account.title }}">

      {%- if format == "icon" and account.logo and account.logo.url -%}
        {%- set logoSize = params.size | default("size-10") -%}
        {%- set logo = account.logo.url | default('/assets/images/logos/default.svg') -%}
        {%- set logoAlt = account.logo.alt | default(account.title) -%}
        {%- set logoStyle = {"base": "mx-auto text-primary-400 " ~ logoSize} -%}
        {{ InlineSvg.render({
                svg: account.logo.inline,
                src: logo,
                alt: logoAlt,
                classes: logoStyle | classes,
                svgClasses: ""
                }) }}
      {%- else -%}
        {{ account.title }}
      {%- endif -%}
    </a>
  {%- endif -%}
{%- endmacro -%}
