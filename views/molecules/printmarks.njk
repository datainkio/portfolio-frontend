{% macro render(params = {}) %}
  {% import "atoms/printmarks/ink-marks.njk" as InkMarks %}
  {% import "atoms/printmarks/trim-marks.njk" as TrimMarks %}
  {% import "atoms/printmarks/margin-bleed-marks.njk" as MarginBleedMarks %}
  {% import "atoms/printmarks/registration-marks.njk" as RegistrationMarks %}
  {%- set classes = params.classes | default("") -%}
  {%- set inset = params.inset | default("24") -%}
  {%- set marginBleed = params.marginBleed | default({color: "white", size: "1", bleedInset: "12", style: "dashed", marginInset: "6"}) -%}
  {%- set trim = params.trim | default({color: "white", size: "3", inset: "12", weight: "1"}) -%}
  {#- Ink and registration marks render unless the caller passes false. -#}
  {%- set showInk = params.ink !== false -%}
  {%- set showRegistration = params.registration !== false -%}
  {#- Scaling: the outer box is a size container the width of the element the marks sit on.
      `printmarks-scale` (styles/decorations.css) redefines the spacing tokens under the inner
      box as shares of that width, so every inset, size, height and gap below it scales with
      the container. Border weights stay in px. -#}
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none [container-type:inline-size] {{ classes | classes }}">
    <div class="absolute inset-{{ inset }} printmarks-scale">
      {%- if showInk %}{{ InkMarks.render() }}{% endif -%}
      {%- if showRegistration %}{{ RegistrationMarks.render() }}{% endif -%}
      {{ TrimMarks.render(trim) }}
      {{ MarginBleedMarks.render(marginBleed) }}
    </div>
  </div>
{% endmacro %}