{#
Params:
  src          string  A plain image URL. Renders a single <img>. Use for simple cases.
  picture      string  Pre-rendered <picture>/<img> markup (e.g. from Sanity's
                        `image.file.html` or the eleventy-img shortcode output).
                        Takes precedence over `src` when both are given — preserves
                        responsive srcset/sizes that a bare `src` can't carry.
  alt          string  Alt text (only applies to the `src` path — `picture` HTML
                        carries its own alt).
  caption      string  Optional figcaption text.
  imgClasses   string  Classes for the `src`-path <img> (default: "w-full h-full object-cover").
#}
{% macro render(params = {}) %}
  {%- set src = params.src -%}
  {%- set picture = params.picture -%}
  {%- set alt = params.alt | default("") -%}
  {%- set caption = params.caption -%}
  {%- set imgClasses = params.imgClasses | default("w-full h-full object-cover") -%}

  {%- if picture or src -%}
    {#- Both buttons below kept as raw markup: they're dialog controls
        (aria-haspopup="dialog", the open/close pair wired to a native
        <dialog>) that atoms/button/button.njk's label/type/onclick shape
        doesn't cover — this is a live component on every project image. -#}
    <figure data-lightbox-el="root" class="contents">
      <button type="button" data-lightbox-el="trigger" class="block w-full h-full cursor-zoom-in" aria-haspopup="dialog">
        {%- if picture -%}
          <span class="block w-full h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:block">{{ picture | safe }}</span>
        {%- else -%}
          <img src="{{ src }}" alt="{{ alt }}" class="{{ imgClasses }}" loading="lazy" />
        {%- endif -%}
      </button>

      <dialog data-lightbox-el="dialog" aria-label="{{ alt | default(caption) | default('Image viewer') }}" class="m-auto max-w-[90vw] max-h-[90vh] bg-transparent p-4 backdrop:bg-black/80">
        <button type="button" data-lightbox-el="close" class="mb-2 text-white bg-neutral-900 hover:bg-neutral-700 py-1 px-3 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">Close</button>
        {%- if picture -%}
          <span class="block max-w-[90vw] max-h-[75vh] [&_img]:max-w-[90vw] [&_img]:max-h-[75vh] [&_img]:object-contain [&_img]:block">{{ picture | safe }}</span>
        {%- else -%}
          <img src="{{ src }}" alt="{{ alt }}" class="block max-w-[90vw] max-h-[75vh] object-contain" />
        {%- endif -%}
      </dialog>
      {% if caption %}
        <figcaption data-lightbox-el="caption" class="mt-2 text-sm text-neutral-600">{{ caption }}</figcaption>
      {% endif %}
    </figure>

    {#- Self-contained progressive enhancement: wires open/close on the dialog above. Module imports are deduped by the browser. -#}
    <script type="module">
      import "/assets/js/lightbox/Lightbox.js";
    </script>
  {%- endif -%}
{% endmacro %}
