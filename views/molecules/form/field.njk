{%- macro render(params = {}) -%}
  {%- set id = params.id -%}
  {%- set name = params.name -%}
  {%- set type = params.type | default("text") -%}
  {%- set required = params.required | default(false) -%}
  {%- set styles = params.styles or {} -%}
  {%- set fieldStyles = styles.field | classes -%}
  {%- set labelStyles = styles.label | classes -%}
  {%- set describedBy = id + "-error" + (" " + id + "-help" if params.help else "") -%}
  <label for="{{ id }}" class="{{ labelStyles }}">{{ params.label }}</label>
  {%- if type == "textarea" %}
    <textarea id="{{ id }}"
              name="{{ name }}"
              rows="{{ params.rows | default(8) }}"
              {%- if required %} required{% endif %}
              aria-describedby="{{ describedBy }}"
              class="{{ fieldStyles }}"></textarea>
  {%- else %}
    <input id="{{ id }}"
           name="{{ name }}"
           type="{{ type }}"
           {%- if params.autocomplete %}autocomplete="{{ params.autocomplete }}"{% endif %}
           {%- if required %}required{% endif %}
           aria-describedby="{{ describedBy }}"
           class="{{ fieldStyles }}">
  {%- endif %}
  {%- if params.help %}
    <p id="{{ id }}-help" class="text-sm text-primary-800">{{ params.help }}</p>
  {%- endif %}
  <p id="{{ id }}-error"
     class="text-sm font-black text-secondary-700"
     data-field-error="{{ name }}"
     hidden></p>
{%- endmacro -%}
