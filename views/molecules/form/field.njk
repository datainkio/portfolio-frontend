{%- macro render(params = {}) -%}
  {%- set id = params.id -%}
  {%- set name = params.name -%}
  {%- set type = params.type | default("text") -%}
  {%- set required = params.required | default(false) -%}
  {%- set fieldStyles = params.fieldStyles | default("p-2 border border-neutral-700 bg-slate-900 text-white rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 aria-[invalid=true]:border-red-500") -%}
  {%- set describedBy = id + "-error" + (" " + id + "-help" if params.help else "") -%}
  <div class="grid gap-2">
    <label for="{{ id }}" class="text-sm font-medium text-white">{{ params.label }}</label>
    {%- if type == "textarea" %}
    <textarea id="{{ id }}"
              name="{{ name }}"
              rows="{{ params.rows | default(8) }}"
              {%- if required %} required{% endif %}
              aria-describedby="{{ describedBy }}"
              class="{{ fieldStyles }}"></textarea>
    {%- else %}
    <input id="{{ id }}"
           name="{{ name }}"
           type="{{ type }}"
           {%- if params.autocomplete %} autocomplete="{{ params.autocomplete }}"{% endif %}
           {%- if required %} required{% endif %}
           aria-describedby="{{ describedBy }}"
           class="{{ fieldStyles }}">
    {%- endif %}
    {%- if params.help %}
    <p id="{{ id }}-help" class="text-sm text-primary-200">{{ params.help }}</p>
    {%- endif %}
    <p id="{{ id }}-error"
       class="text-sm text-red-400"
       data-field-error="{{ name }}"
       hidden></p>
  </div>
{%- endmacro -%}
