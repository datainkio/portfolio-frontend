{%- import "molecules/social-account/social-account.njk" as social_account -%}
{%- import "atoms/link/link.njk" as Link -%}
{%- macro render(params = {}) -%}

  {%- set socialAccounts = params.accounts or [] -%}
  {%- set itemStyles = {"base": "size-full content-center", "md": "gap-4", "lg": "p-0"} -%}
  {% if socialAccounts | length > 0 %}
    <ul class="{{ ['gap-2', params.classes] | classes }}" role="list">
      {% for account in socialAccounts %}
        <li class="{{ itemStyles | classes }}">{{ social_account.render({ account: account, format: "text" }) }}</li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No social accounts available</p>
  {% endif %}
{%- endmacro -%}
