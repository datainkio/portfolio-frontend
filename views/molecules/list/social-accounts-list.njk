{%- import "molecules/social-account/social-account.njk" as social_account -%}
{%- import "atoms/link/link.njk" as Link -%}
{%- macro render(params = {}) -%}

  {#- DATA GUARDS: Ensure required parameters are set and have default values -#}
  {%- set socialAccounts = params.accounts or [] -%}

  {% if socialAccounts | length > 0 %}
    <ul class="flex items-center gap-x-2 {{ [params.classes] | classes }}"
        role="list">
      {% for account in socialAccounts %}
        <li>{{ social_account.render({ account: account, format: "icon", logoSize: "size-6" }) }}</li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No social accounts available</p>
  {% endif %}

{%- endmacro -%}
