{% import "atoms/link/nav-link.njk" as nav_link with context %}
{% macro render(params = {}) %}

  {#- DATA GUARDS -#}
  {%- set items = params.items | default([]) -%}

  {#- STYLES -#}
  {%- set ulClasses = params.ulClasses -%}
  {%- set liClasses = params.liClasses -%}
  {%- set aClasses = params.aClasses -%}

  {#- DISPLAY -#}
  <ul class="{{ ulClasses }}" role="list">
    {%- for entry in items -%}
      {%- set hasHref = entry and (entry.url or entry.href) -%}
      {%- set entryHref = entry.url or entry.href -%}
      {%- set isCurrent = entryHref == page.url -%}
      {%- if hasHref and (entry.title or entry.key) -%}
        {%- if isCurrent -%}
          <li class="{{ liClasses }}">
            <span class="{{ aClasses }}" aria-current="page">{{ entry.title or entry.key }}</span>
          </li>
        {%- else -%}
          <li class="{{ liClasses }}">{{ nav_link.render({ entry: entry, class: aClasses }) }}</li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>
{% endmacro %}
