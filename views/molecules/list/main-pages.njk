{% import "atoms/link/nav-link.njk" as nav_link %}
{% macro render(params = {}) %}

  {#- DATA GUARDS -#}
  {%- set items = params.items | default([]) -%}

  {#- STYLES -#}
  {%- set styles = params.styles or {} -%}
  {#- Opt-in nesting: only when `styles.children` is given do entries' own
      `children` render, as a nested list. -#}
  {%- set childStyles = styles.children -%}

  {#- DISPLAY -#}
  <ul class="{{ params.classes | classes }}" role="list">
    {%- for entry in items -%}
      {%- set hasHref = entry and (entry.url or entry.href) -%}
      {%- set entryHref = entry.url or entry.href -%}
      {%- set isCurrent = entryHref == params.currentUrl -%}
      {#- `hide` is this project's own eleventyNavigation key: the page still
          builds, but no list links to it. -#}
      {%- if hasHref and (entry.title or entry.key) and not entry.hide -%}
        {%- if isCurrent -%}
          <li class="{{ styles.item | classes }}">
            <span class="{{ styles.link | classes }}" aria-current="page">{{ entry.pageNavLabel or entry.title or entry.key }}</span>
            {%- if childStyles and entry.children and entry.children.length -%}
              {{ render({ items: entry.children, currentUrl: params.currentUrl, classes: childStyles.list, styles: childStyles }) }}
            {%- endif %}
          </li>
        {%- else -%}
          <li class="{{ styles.item | classes }}">{{ nav_link.render({ entry: entry, classes: styles.link, currentUrl: params.currentUrl }) }}
            {%- if childStyles and entry.children and entry.children.length -%}
              {{ render({ items: entry.children, currentUrl: params.currentUrl, classes: childStyles.list, styles: childStyles }) }}
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>
{% endmacro %}
