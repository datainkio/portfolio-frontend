{#- Display links targeting subsections (i.e. industry groups) within the work section on the homepage. -#}
{% macro render(params = {}) %}
  {%- set overrides = params.classes | default("") -%}
  {%- set industries = params.industries | default({}) -%}
  {%- set ulStyles = {
    "base": "flex flex-col overflow-hidden text-2xl list-none m-0 divide-y-2 divide-slate-800 w-full",
    "lg": "grid grid-flow-col bg-slate-950 divide-y-0 divide-x-2"
  } -%}
  {%- set liStyles = {
    "base": "text-primary-200 bg-slate-950 w-full flex justify-center",
    "hover": "bg-slate-950 text-neutral-50",
    "has-[[aria-current=true]]": "bg-slate-900 text-slate-200 font-medium inner-border inner-border-slate-400",
    "max-lg:has-[[aria-current=true]]": "order-first  pl-8"
  } -%}
  {%- set aStyles = {
    "base": "h-16 w-full flex items-center justify-left no-underline font-display leading-none ",
    "lg": "h-16 justify-center",
    "aria-[current=true]": "arrow-prefix"
  } -%}

  <ul data-projects-el="industry-links"
      class="{{ ulStyles | classes }} {{ overrides }}">
    {% for industryTitle, projects in industries %}
      <li class="{{ liStyles | classes }}">
        {#- Kept as raw markup: this anchor is a documented WorkNavManager
            scrollspy target (see industry-links.md "Active-state contract") —
            the data-projects-el attribute and JS-driven aria-current wiring
            aren't things atoms/link/link.njk supports, and this drives live
            homepage navigation. -#}
        <a href="#{{ industryTitle | slugify }}"
           data-projects-el="industry-link"
           class="{{ aStyles | classes }}">{{ industryTitle }}</a>
      </li>
    {% endfor %}
  </ul>
{% endmacro %}
