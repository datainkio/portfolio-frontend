{% macro render(params = {}) %}
  {%- set classes = params.classes | default("leading-none") -%}
  {%- set industries = params.industries | default([]) -%}
  {%- set ulStyles = {
    base: "leading-none",
    md: "flex flex-row gap-8 justify-center"
  } -%}
  {%- set liStyles = {
    base: "my-0 leading-none flex-1"
  } -%}
  {%- set aStyles = {
    base: "block py-0 no-underline font-display text-md leading-snug text-center"
  } -%}

  <ul data-projects-el="industry-links" class="{{ ulStyles | classes }}">
    {% for industryTitle, projects in industries %}
      <li class="{{ liStyles | classes }}">
        <a href="#industry-{{ industryTitle | slugify }}" data-projects-el="industry-link" class="{{ aStyles | classes }}">{{ industryTitle }}</a>
      </li>
    {% endfor %}
  </ul>
{% endmacro %}