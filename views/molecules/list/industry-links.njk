{#- Display links targeting subsections (i.e. industry groups) within the work section on the homepage. -#}
{% macro render(params = {}) %}
  {%- set overrides = params.classes | default("") -%}
  {%- set industries = params.industries | default({}) -%}
  {%- set ulStyles = {"base": "flex flex-col text-md m-0 w-full font-display bg-slate-950"} -%}
  {%- set liStyles = {
    "base": "border-x border-b border-slate-700 text-primary-200 grid grid-cols-6 justify-center items-center",
    "hover": "border border-secondary-400/40 bg-secondary-700/10 text-secondary-400",
    "has-[[aria-current=true]]": "text-secondary-400 bg-secondary-700/15  border border-secondary-400",
    "first": "border-t",
    "last": ""
  } -%}
  {%- set aStyles = {
    "base": "h-full p-4 border-l border-slate-700 col-span-5 no-underline leading-none",
    "aria-[current=true]": "arrow-suffix border-secondary-400"
  } -%}

  <ol data-projects-el="industry-links"
      class="{{ ulStyles | classes }} {{ overrides }}">
    {% for industryTitle, projects in industries %}
      <li class="{{ liStyles | classes }}">
        <span class="p-2 text-center">00</span>
        {#- Kept as raw markup: this anchor is a documented WorkNavManager
            scrollspy target (see industry-links.md "Active-state contract") —
            the data-projects-el attribute and JS-driven aria-current wiring
            aren't things atoms/link/link.njk supports, and this drives live
            homepage navigation. -#}
        <a href="#{{ industryTitle | slugify }}"
           data-projects-el="industry-link"
           class="{{ aStyles | classes }}">{{ industryTitle }}</a>
      </li>
    {% endfor %}
  </ol>
{% endmacro %}
