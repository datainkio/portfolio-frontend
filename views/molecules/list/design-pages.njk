{#
Design Navigation Component
Uses eleventyNavigation to display Design section and its children
Accessible navigation with ARIA labels and semantic structure
#}

{% import "atoms/link/link.njk" as Link %}
{#- `nav` is pre-filtered eleventyNavigation entries from the caller, e.g.
    `collections.all | eleventyNavigation("Design")`. -#}
{% macro render(params = {}) %}
{% set designNav = params.nav or [] %}
{% set currentUrl = params.currentUrl %}

{% if designNav.length %}
  <nav
    class="design-navigation border-l-2 border-slate-700 pl-4 mb-8"
    role="navigation"
    aria-label="Design section navigation">
    <ul class="space-y-2" role="list">
      {% for item in designNav %}
        <li class="text-sm">
          {{ Link.render({
            url: item.url,
            text: item.title,
            ariaCurrent: "page" if item.url == currentUrl else "",
            classes: "block py-1 px-2 rounded transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400" + (" bg-primary-900 text-primary-100 font-medium" if item.url == currentUrl else " text-neutral-200 hover:text-neutral-50 hover:bg-slate-800")
          }) }}

          {# Display children if they exist #}
          {% if item.children.length %}
            <ul class="mt-2 ml-4 space-y-1 border-l border-slate-800 pl-3" role="list">
              {% for child in item.children %}
                <li class="text-xs">
                  {{ Link.render({
                    url: child.url,
                    text: child.title,
                    ariaCurrent: "page" if child.url == currentUrl else "",
                    classes: "block py-1 px-2 rounded transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400" + (" bg-primary-900 text-primary-100 font-medium" if child.url == currentUrl else " text-neutral-300 hover:text-neutral-50 hover:bg-slate-800")
                  }) }}

                  {# Display grandchildren if they exist (third level) #}
                  {% if child.children.length %}
                    <ul class="mt-1 ml-3 space-y-1 border-l border-slate-800 pl-2" role="list">
                      {% for grandchild in child.children %}
                        <li class="text-xs">
                          {{ Link.render({
                            url: grandchild.url,
                            text: grandchild.title,
                            ariaCurrent: "page" if grandchild.url == currentUrl else "",
                            classes: "block py-0.5 px-2 rounded transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-400" + (" bg-primary-900 text-primary-100 font-medium" if grandchild.url == currentUrl else " text-neutral-400 hover:text-neutral-50 hover:bg-slate-800")
                          }) }}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
{% endmacro %}
