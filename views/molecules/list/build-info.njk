{% macro render(params = {}) %}
  <dl class="{{ params.dlStyles }}">
    <dt data-current-git-build class="{{ params.dtStyles }}">Git</dt>
    <dd data-current-git-build
        class="{{ params.ddStyles }} text-primary-700 ">
      {% if params.buildVersions.git.sha %}
        {{ params.buildVersions.git.branch }}@{{ params.buildVersions.git.sha }}
        {% if params.buildVersions.git.dirty %}*{% endif %}
      {% endif %}
    </dd>
    <dt data-current-eleventy-build class="{{ params.dtStyles }}">11ty</dt>
    <dd data-current-eleventy-build
        class="{{ params.ddStyles }} text-secondary-700 ">
      v{{ params.buildVersions.eleventy }}
    </dd>
    <dt data-current-sanity-build class="{{ params.dtStyles }}">Sanity</dt>
    <dd data-current-sanity-build
        class="{{ params.ddStyles }} text-accent-700 ">
      v{{ params.buildVersions.sanity }}
    </dd>
    <dt data-current-figma-build class="{{ params.dtStyles }}">Figma</dt>
    <dd data-current-figma-build
        class="{{ params.ddStyles }} text-tertiary-600 ">
      {% if params.buildVersions.figma.fileId %}
        fileID.{{ params.buildVersions.figma.fileId | truncate(12, true, "…") }}
      {% endif %}
    </dd>
    <dt class="{{ params.dtStyles }}">FPS</dt>
    <dd data-current-fps-build
        class="{{ params.ddStyles }} text-tertiary-600 ">
      —
    </dd>
  </dl>
{% endmacro %}
