{% import "molecules/card/project.njk" as Card %}
{% macro render(params = {}) %}
  {%- set list = {"base": "grid gap-y-12 gap-x-4", "md": "grid-cols-2"} -%}
  {%- set item = {} -%}
  <ul data-projects-el="list" class="{{ list | classes }}">
    {% for project in params.projects %}
      <li data-projects-el="project" class="{{ item | classes }}">
        {{ Card.render({ project: project, headingLevel: 4, eager: loop.first and loop.parent.first, classes: "shadow-neutral-950/50 shadow-sm" }) }}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}
