{% import "molecules/list/organizations.njk" as Organizations %}
{% import "molecules/list/roles.njk" as Roles %}
{% macro render(params = {}) %}
<!-- PROJECT DETAILS -->
<dl class="flex flex-row flex-wrap gap-2 font-light content-center">
  <dt class="sr-only">Clients, Partners, and Employers</dt>
  <dd class=" border-r-neutral border-r pr-2 leading-tight">
    {{ Organizations.render({ orgs: params.orgs }) }}
  </dd>
  <dt class="sr-only">Roles</dt>
  <dd class="leading-tight">{{ Roles.render({ roles: params.roles }) }}</dd>
</dl>
{% endmacro %}
