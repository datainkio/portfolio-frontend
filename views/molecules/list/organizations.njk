{#- `orgs` is pre-resolved organization records from the caller, e.g.
    `collections.organizations | findRecord(project.organizations)`. This stays
    presentational rather than resolving its own data. -#}
{% macro render(params = {}) %}
{% set orgs = params.orgs %}
{% if orgs %}
  <ul class="flex flex-row list-none p-0 m-0">
    {% for org in orgs %}
      <li class="p-0 m-0">
        {{ org.title }}
        {% if not loop.last %},&nbsp;{% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
{% endmacro %}
