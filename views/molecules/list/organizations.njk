{#- Expects `orgs` (pre-resolved organization records) to already be set by the
    caller, e.g. `{% set orgs = collections.organizations | findRecord(project.organizations) %}` —
    kept presentational rather than resolving its own data. -#}
{% if orgs %}
  <ul class="flex flex-row list-none p-0 m-0">
    {% for org in orgs %}
      <li class="p-0 m-0">
        {{ org.name }}
        {% if not loop.last %},&nbsp;{% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}