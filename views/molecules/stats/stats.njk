{% macro render(params = {}) %}
  {%- set stats = params.stats | default([]) -%}
  {%- set classes = params.classes | default("") -%}
  <dl class="{{ classes | default("") }}"
      aria-label="{{ params.aria | default("Metadata") }}">
    {% for item in stats %}
      {% if item.value %}
        <div class="meta-item font-display text-sm flex flex-col gap-1 p-2">
          <dt class="text-neutral-300">{{ item.key }}</dt>
          <dd>
            {{ item.value }}
          </dd>
        </div>
      {% endif %}
    {% endfor %}
  </dl>
{% endmacro %}
