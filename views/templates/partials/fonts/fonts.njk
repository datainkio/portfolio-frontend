<!-- Preload the display font (DraftPaper) — drives hero LCP text -->
<link rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/fonts/DRAFTPAPER/DRAFTPAPER.woff2"
      crossorigin="anonymous" />

<!-- IBM Plex Sans (body face) is self-hosted — @font-face in styles/typography/imports.css.
     Nothing render-blocking is fetched from Google Fonts any more, so no preconnects:
     Cormorant below is the only Google request and it is already off the render path. -->

<!-- Cormorant Garamond: used only below the fold
     case-study modal, prev/next nav, etc.
     Loaded non-render-blocking so it stays off the FCP/LCP critical path.

     Note: text= must include every character rendered in this face.
-->
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300&text=ViewPreviousNext&display=swap"
      media="print"
      onload="this.onload=null;this.media='all'" />

<noscript>
     <link rel="stylesheet"
           href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300&text=ViewPreviousNext&display=swap" />
</noscript>
