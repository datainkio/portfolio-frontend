{# Pre-paint return-visit check. Runs synchronously right after the landing
   header so a repeat visit this session never flashes the loading pulse.
   Duplicates, by necessity (no imports before paint):
     - the sessionStorage key + `visited` shape from
       js/choreography/managers/SessionManager/SessionManager.js
     - the `data-preloader-state` / "exit" pair from js/preloader/constants.js
   Change any of those and change this. #}
<script>
  (function () {
          try {
                  var raw = sessionStorage.getItem("dataink_session");
                  var state = raw ? JSON.parse(raw) : null;
                  if (state && state.visited === true) {
                          var el = document.querySelector("[data-preloader]");
                          if (el) el.setAttribute("data-preloader-state", "exit");
                  }
          } catch (e) {
                  // Storage unavailable (private mode, disabled, etc.) — fall
                  // through to the normal first-visit loading sequence.
          }
  })();
</script>
