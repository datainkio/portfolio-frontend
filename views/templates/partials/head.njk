<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>

  <link rel="preload" as="style" href="{{ '/assets/styles.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}" />

  {% include "templates/partials/social.njk" %}
  {% include "templates/partials/manifest.njk" %}
  {% include "templates/partials/icon.njk" %}
  {% include "templates/partials/fonts.njk" %}

  {% if enableChoreography and runtime and runtime.bundleJs and eleventy.env.runMode == "build" %}
    <!-- Warm the choreography bundle early; director:ready gates the hero reveal (LCP).
             Build-mode only: in dev (serve/watch) the bundle is a multi-MB sourcemapped
             artifact, so eagerly preloading it would slow the dev page, not speed it. -->
    <link rel="modulepreload" href="/assets/js/choreography/bundle.js" />
  {% endif %}
  {{ scripts | safe }}
  {% block extraHeadContent %}
  {% endblock extraHeadContent %}
</head>
