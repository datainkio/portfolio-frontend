<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  {% if metaDescription %}
    <meta name="description" content="{{ metaDescription }}" />
  {% endif %}
  {% if metaKeywords %}
    <meta name="keywords" content="{{ metaKeywords }}" />
  {% endif %}
  <meta name="author" content="{{ author | default("Site Author") }}" />
  {% if canonicalUrl %}
    <link rel="canonical" href="{{ canonicalUrl }}" />
  {% endif %}

  {% if ogTitle %}
    <meta property="og:title" content="{{ ogTitle }}" />
  {% endif %}
  {% if ogDescription %}
    <meta property="og:description" content="{{ ogDescription }}" />
  {% endif %}
  {% if ogImage %}
    <meta property="og:image" content="{{ ogImage }}" />
  {% endif %}
  {% if ogUrl %}
    <meta property="og:url" content="{{ ogUrl }}" />
  {% endif %}

  <meta name="twitter:card" content="summary_large_image" />
  {# {% include "molecules/fonts.njk" %} #}
  <link rel="preload" as="style" href="{{ '/assets/styles.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="{{ site.manifest.theme_color }}" />
  <meta name="theme-color"
        media="(prefers-color-scheme: dark)"
        content="{{ site.manifest.theme_color_dark }}" />
  <meta name="application-name" content="{{ site.manifest.short_name }}" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <meta name="apple-mobile-web-app-title"
        content="{{ site.manifest.short_name }}" />
  <!-- Icons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {% for icon in site.manifest.icons %}
    <link rel="icon"
          type="{{ icon.type }}"
          sizes="{{ icon.sizes }}"
          href="{{ icon.src }}" />
  {% endfor %}

  {% include "templates/partials/fonts.njk" %}

  {% if enableChoreography and runtime and runtime.bundleJs and eleventy.env.runMode == "build" %}
    <!-- Warm the choreography bundle early; director:ready gates the hero reveal (LCP).
             Build-mode only: in dev (serve/watch) the bundle is a multi-MB sourcemapped
             artifact, so eagerly preloading it would slow the dev page, not speed it. -->
    <link rel="modulepreload" href="/assets/js/choreography/bundle.js" />
  {% endif %}
  {{ scripts | safe }}
  {% block extraHeadContent %}
  {% endblock extraHeadContent %}
</head>
