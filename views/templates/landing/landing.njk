{% extends "layouts/base.njk" %}
{% import "organisms/header/landing/landing-header.njk" as LandingHeader %}

{% block mainStyles %}{{ {"base": "pt-24 grid grid-cols-12 gap-8 max-w-[1280px] min-h-dvh mx-auto"} | classes }}{% endblock mainStyles %}
{%- set abstractStyles = {"base": "prose text-primary-500 col-start-1 col-span-6 pl-2", "sm": "", "md": "", "lg": "", "xl": ""} -%}

{% block content %}

  {{ LandingHeader.render({ title: title | default('Untitled') , abstract: abstract}) }}
  {% if abstract and abstract | length > 0 %}
    <section data-doc-abstract class="{{ abstractStyles | classes }}">
      {{ abstract | safe }}
    </section>
  {% endif %}
  {% if content %}
    {{ content | safe }}
  {% elif not title %}
    {% loremPars 3 %}
  {% endif %}

  {% include "templates/partials/choreography-script.njk" %}
{% endblock content %}
