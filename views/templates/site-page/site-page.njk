{% extends "layouts/base.njk" %}
{% import "molecules/navigation/breadcrumbs.njk" as Breadcrumbs %}
{#
  General-use page.
  Data: paginated from `collections.sitePages`, aliased as `sitePage`
  (see ../../../ia/site-page.md).
  Shape produced by `frontend/data/sanity/transforms/sitePage.js` + `sitePageProjection.js`.
  Contract: content-model/documents/pages/sitePage.md
#}

{# ─── Styles ──────────────────────────────────────────────────────────────── #}
{%- set titleStyles = {"base": "font-display text-4xl text-neutral-100", "md": "text-6xl"} -%}
{%- set abstractStyles = {"base": "max-w-[68ch] text-xl text-neutral-100"} -%}
{%- set bodyStyles = {"base": "prose prose-headings:text-neutral-100 max-w-[68ch] text-neutral-100"} -%}

{% block content %}
  <article class="space-y-12">
    <header class="space-y-6">
      {{ Breadcrumbs.render({ trail: sitePage.trail }) }}
      <h1 class="{{ titleStyles | classes }}">{{ sitePage.title }}</h1>
      {%- if sitePage.abstract -%}
        <p class="{{ abstractStyles | classes }}">{{ sitePage.abstract }}</p>
      {%- endif -%}
    </header>

    {#- BODY (Portable Text → HTML, prepared by transform) -#}
    {%- if sitePage.bodyHtml -%}
      <div class="{{ bodyStyles | classes }}">{{ sitePage.bodyHtml | safe }}</div>
    {%- endif -%}
  </article>
{% endblock content %}
