{% extends "layouts/base.njk" %}
{% import "atoms/link/link.njk" as Link %}

{% block content %}
  <article class="prose lg:prose-xl">
    <h1>{{ title }}</h1>
    <p class="text-sm text-gray-500">
      Published on {{ date | date("MMMM DD, YYYY") }}
    </p>
    {{ content | safe }}
  </article>

  <nav class="mt-8 flex justify-between">
    {% if previousPost %}
      {{ Link.render({ url: previousPost.url, text: "← " + previousPost.title, class: "text-blue-500 hover:underline" }) }}
    {% endif %}
    {% if nextPost %}
      {{ Link.render({ url: nextPost.url, text: nextPost.title + " →", class: "text-blue-500 hover:underline" }) }}
    {% endif %}
  </nav>
{% endblock %}