{
  "permissions": {
    "deny": [
      "Edit(/styles/colors.css)",
      "Edit(/styles/tokens.css)",
      "Edit(/styles/motion.css)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(gh workflow run *deploy-production*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task|Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/../.claude/hooks/log-agent-flow.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/../.claude/hooks/log-agent-flow.sh\" || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/../../wiki/tools/stale.py\" ] && python3 -I \"$CLAUDE_PROJECT_DIR/../../wiki/tools/stale.py\" --hook 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": false
  }
}
