{
  "name": "datainkio",
  "version": "2.0.0",
  "description": "Personal portfolio website built with 11ty, Tailwind CSS 4.0, automated Figma design system integration, and CMS content",
  "type": "module",
  "private": true,
  "packageManager": "npm@10",
  "author": {
    "name": "Russell Lebo",
    "email": "russell@dataink.io",
    "url": "https://dataink.io"
  },
  "license": "MIT",
  "homepage": "https://dataink.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/datainkio/portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/datainkio/portfolio/issues"
  },
  "keywords": [
    "portfolio",
    "11ty",
    "eleventy",
    "tailwindcss",
    "figma-integration",
    "cms",
    "design-system",
    "static-site-generator",
    "jamstack",
    "sanity"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "scripts": {
    "_comment_development": "=== DEVELOPMENT WORKFLOWS ===",
    "start": "run-s build:css:dev dev",
    "start:nobundle": "npm run dev:nobundle",
    "dev": "run-p dev:css dev:11ty dev:js",
    "dev:nobundle": "BUNDLE_JS=false run-s build:js build:css:dev dev:nobundle:serve",
    "dev:nobundle:serve": "run-p dev:css dev:11ty",
    "dev:css": "node scripts/build/buildCSS.js --watch",
    "dev:11ty": "eleventy --serve",
    "dev:js": "node scripts/build/buildChoreography.js --watch",
    "_comment_build": "=== BUILD PROCESSES ===",
    "build": "run-s clean build:design build:js build:11ty build:css",
    "build:nobundle": "BUNDLE_JS=false run-s clean build:design build:js build:11ty build:css",
    "build:debug": "DEBUG=true run-s clean:debug build:design build:js build:11ty build:css",
    "build:force": "FORCE_REFRESH=true run-s clean build:design build:js build:11ty build:css",
    "build:11ty": "eleventy --quiet",
    "build:css": "node scripts/build/buildCSS.js --minify",
    "build:css:dev": "node scripts/build/buildCSS.js",
    "build:design": "node scripts/build/fetchFigma.js",
    "build:design:variables": "node scripts/build/fetchFigmaVariables.js",
    "sync:components": "node scripts/build/syncComponents.js",
    "build:readme": "node scripts/generate/buildReadmeAssets.js",
    "inventory:design": "node scripts/generate/inventoryDesignSystem.js",
    "build:motion": "node scripts/generate/buildMotionTokens.js",
    "check:motion": "node scripts/generate/buildMotionTokens.js --check",
    "build:design:debug": "DEBUG=true node scripts/build/fetchFigma.js",
    "build:js": "node scripts/build/buildChoreography.js",
    "build:preview": "node scripts/help/buildPreview.js",
    "build:preview:dev": "node scripts/help/buildPreview.js --dev",
    "build:preview:verbose": "node scripts/help/buildPreview.js --verbose",
    "fresh": "run-s clean build",
    "quick": "run-s build:js build:11ty build:css",
    "preview": "run-s quick serve:site",
    "serve:site": "node scripts/dev/serveSite.js",
    "design": "run-s build:design build:css",
    "_comment_testing": "=== TESTING & VALIDATION ===",
    "test": "run-p test:logger test:choreography test:figma",
    "test:logger": "node test/logger/index.js",
    "test:figma": "node test/figma/tokens.test.js && node test/figma/palette.test.js && node test/figma/variables.test.js && node test/figma/components.test.js",
    "test:site": "node test/site/pager.test.js",
    "test:choreography": "node test/choreography/hero-events.test.js && node test/choreography/animation-bus-flow.test.js",
    "test:logger:custom": "DEBUG=true node test/logger/custom-styles.test.js",
    "test:logger:detection": "DEBUG=true node test/logger/error-detection.test.js",
    "test:logger:enhancements": "node test/logger/simple-enhancements.test.js",
    "test:logger:errors": "DEBUG=true node test/logger/errors.test.js",
    "test:logger:optional": "DEBUG=true node test/logger/optional-parameter.test.js",
    "test:logger:realworld": "DEBUG=true node test/logger/real-world.test.js",
    "test:logger:styles": "DEBUG=true node test/logger/styles.test.js",
    "validate": "run-s format:check lint:frontmatter lint:palette check:motion audit:sidecars test",
    "validate:env": "node scripts/help/validateEnvironment.js",
    "_comment_maintenance": "=== MAINTENANCE & UTILITIES ===",
    "clean": "node scripts/build/clearSiteFolder.js",
    "clean:debug": "DEBUG=true node scripts/build/clearSiteFolder.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:njk": "djlint views --reformat",
    "format:njk:check": "djlint views --check",
    "lint:njk": "djlint views --lint",
    "lint:frontmatter": "node scripts/frontmatter/lintFrontmatter.js",
    "lint:palette": "node scripts/lint/lintPalette.js",
    "fix:frontmatter": "node scripts/frontmatter/normalizeFrontmatter.js",
    "audit:frontmatter": "node scripts/frontmatter/auditFrontmatter.js",
    "audit:sidecars": "node scripts/frontmatter/auditFrontmatter.js --check",
    "_comment_scaffolding": "=== COMPONENT SCAFFOLDING ===",
    "scaffold:component": "node scripts/generate/scaffold.js component",
    "scaffold:page": "node scripts/generate/scaffold.js page",
    "scaffold:section": "node scripts/generate/scaffold.js section",
    "scaffold:list": "node scripts/generate/scaffold.js list",
    "_comment_diagrams": "=== DIAGRAM EXPORT ===",
    "diagrams:export": "node scripts/generate/exportDiagrams.js",
    "diagrams:export:onboarding": "node scripts/generate/exportDiagrams.js --dir onboarding",
    "diagrams:export:choreography": "node scripts/generate/exportDiagrams.js --dir js/choreography",
    "diagrams:export:storyboards": "node scripts/generate/exportStoryboards.js",
    "diagrams:watch:storyboards": "nodemon --watch docs/storyboards --ext md --exec \"npm run diagrams:export:storyboards\"",
    "_comment_deployment": "=== DEPLOYMENT ===",
    "pre-deploy": "run-s validate build",
    "_comment_help": "=== HELP & DOCUMENTATION ===",
    "doctor": "node scripts/help/systemCheck.js",
    "help": "node scripts/help/showAvailableWorkflows.js",
    "ref": "node scripts/help/quickRef.js",
    "setup": "run-s validate:env doctor"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-fetch": "^5.0.1",
    "@11ty/eleventy-img": "^5.0.0",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@datainkio/lumberjack": "^0.1.0",
    "@datainkio/textparty": "^0.1.0",
    "@portabletext/react": "^6.0.3",
    "@portabletext/to-html": "^5.0.2",
    "@sanity/client": "^6.29.1",
    "@svgdotjs/svg.js": "^3.2.4",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "groq": "^3.68.0",
    "gsap": "^3.14.2",
    "markdown-it": "^14.1.0",
    "opentype.js": "^1.3.4",
    "slugify": "^1.6.6",
    "tailwind-extended-shadows": "^0.4.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@tailwindcss/typography": "^0.5.19",
    "ansi-colors": "^4.1.3",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "djlint": "^1.40.7",
    "esbuild": "^0.23.1",
    "glob": "^11.0.0",
    "html-minifier-terser": "^7.2.0",
    "lorem-ipsum": "^2.0.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-jinja-template": "^2.1.0"
  }
}
