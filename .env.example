# Sanity content API (primary)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_PARALLEL=true
# Generate a read token in Sanity (Project Settings > API) and paste it here
SANITY_READ_TOKEN=
# Optional CDN controls. Fresh-by-default build strategy: CDN off (live API),
# short cache TTL. SANITY_FORCE_REFRESH=false (dev default here) serves queries from
# the AssetCache under `npm start`; production builds always fetch. Use
# `npm run start:fresh` when CMS edits must show. Unset = fresh.
SANITY_USE_CDN=false
SANITY_FORCE_REFRESH=false
# Cache duration for Sanity queries (e.g. 1d, 6h, 30m)
SANITY_CACHE_DURATION=1h
# Sanity API version used by the contact form's direct mutation write
SANITY_API_VERSION=2026-03-01
# Sanity WRITE token for the contact form (Project Settings > API > Tokens, role: Editor).
# WARNING: injected at build time and PRESENT IN THE DEPLOYED HTML as a data
# attribute. Accepted tradeoff for this portfolio — use a minimal-permission
# (write, not delete/manage) token. See contact form spec §4.
SANITY_WRITE_TOKEN=

# Figma API Configuration
# The design-system library, read by `npm run build:design`
# (dataink.io Design System: tl8ANcSSVEzPOS6ZU6lSI1)
FIGMA_FILE_ID=
FIGMA_TOKEN=

# Legacy (supported but deprecated):
# FIGMA_ACCESS_TOKEN=

# Asset Configuration
IMAGE_PATH=/content/images/

# Development Options
DEBUG=true
# Outline every element in the browser to aid building layouts/templates.
# See styles/utilities/debug-outlines.css. Requires a dev-server restart.
DEBUG_OUTLINES=false
