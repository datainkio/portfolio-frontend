{"nodes": [{"id": "js_choreography_templates_landing_landingsequence_landingsequence", "label": "LandingSequence", "file_type": "code", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L18-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"id": "frontend.js.choreography.templates.landing.landingsequence", "role": "Page narrative flow \u2014 choreographs the complete landing page animation sequence by listening to AnimationBus events and coordinating section transitions", "status": "stable", "surface": "internal", "scope": "frontend", "runtime": "browser", "type": "template", "rationale": "Owns no DOM and no ScrollTrigger \u2014 it listens on AnimationBus and cues section lifecycle methods in order, so it never reaches into an organism's internals beyond its public play* methods."}}, {"id": "js_choreography_templates_landing_landingsequence_boot_gates", "label": "Boot Gates \u2014 director:ready \u2192 preloader:out", "file_type": "concept", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L26-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"sequence": "DOMContentLoaded (idle-deferred) \u2192 AnimationDirector constructs bus, ScrollEffectsCoordinator, CardManager, SECTION_REGISTRY, managers, LandingSequence \u2192 window director:ready \u2192 Preloader exit animation \u2192 window preloader:out", "rationale": "Never bypass. LandingSequence.start() only stages the video's landing (hidden resting) state at preloader:out; playing the video intro there would race the header."}}, {"id": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "label": "Serial Landing Chain", "file_type": "concept", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L36-L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"chain": "HomeHeaderManager._arm \u2192 HOME_HERO_HOLD.delay (gsap.delayedCall) \u2192 HomeHeaderManager._runTransition (deconstruct) \u2192 home:outro:complete \u2192 LandingSequence._startVideoIntro (video.playIntro, awaits _ensureVideoReady) \u2192 video:intro:complete \u2192 LandingSequence._armBioIntro (BIO_INTRO_HOLD.delay) \u2192 await bio.playLanding (BIO_GEL_ENTRANCE) \u2192 landing timeline onComplete \u2192 bio.playIntro \u2192 bio:intro:complete \u2192 HomeHeaderManager._playMenuIn \u2192 home:intro:complete", "rationale": "The header opens the landing and closes it: hero exit is the page's first statement, the video reveal answers it, Bio follows a beat later, and the menu rail arrives last once Bio has had its say."}}, {"id": "js_choreography_templates_landing_landingsequence_outro_cue_deadlock_avoidance", "label": "Video Cued off home:outro:complete (deadlock avoidance)", "file_type": "rationale", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"rationale": "Load-bearing: the menu rail's build waits for bio:intro:complete (HomeHeaderManager._playMenuIn), so cueing Bio's chain off the rail's intro would deadlock \u2014 the rail waiting on Bio, Bio waiting on the rail. The hero exiting is the earlier, unblocked cue. Anything later added to this chain must respect that cycle."}}, {"id": "js_choreography_templates_landing_landingsequence_animationbus_contract", "label": "Every Link Is an Event, Not a Call", "file_type": "rationale", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"rationale": "Cross-section coordination goes through AnimationBus with EVENTS constants; LandingSequence never reaches into an organism's internals beyond its public play* methods, keeping sections decoupled and independently testable."}}, {"id": "js_choreography_templates_landing_landingsequence_reduced_motion_zeroed_holds", "label": "Reduced Motion Zeroes Holds Rather Than Skipping Links", "file_type": "rationale", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L61-L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"rationale": "A gated profile still emits \u2026:intro:complete (AbstractSection jumps the intro to progress(1)), so the chain completes without motion instead of stalling. Holds go to zero and timelines jump to progress 1 \u2014 events still emit and the chain stays intact."}}, {"id": "js_choreography_templates_landing_landingsequence_delayedcall_timers", "label": "Timers Are gsap.delayedCall, Never setTimeout", "file_type": "rationale", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"rationale": "gsap.delayedCall is ticker-synced, pausable, and killable in destroy(); setTimeout is none of those and would leak past teardown."}}, {"id": "js_choreography_templates_landing_landingsequence_bio_disengaged_from_scroll", "label": "Bio Is Disengaged from Scroll", "file_type": "rationale", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L61-L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"rationale": "Bio's ScrollTrigger still fires enter/exit/onEnterBack/onLeaveBack for side effects and logging, but the reveal is owned by the landing chain \u2014 the reveal is disengaged from scroll so narrative pacing, not scroll position, drives it."}}, {"id": "js_choreography_templates_landing_landingsequence_gel_entrance_gate", "label": "Gel Entrance Gates the Bio Intro", "file_type": "rationale", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"rationale": "bio.playLanding() is awaited, not fired-and-forgotten \u2014 the heading band has to land before the SplitText reveal starts over it. The promise resolves via AbstractSection's PromiseResolverQueue and resolves immediately under a gated profile so the await can never stall the chain.", "reference": "../../molecules/bio-motion/heading-gel.md"}}, {"id": "js_choreography_templates_landing_landingsequence_known_drift", "label": "Known Drift \u2014 None Outstanding", "file_type": "concept", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L76-L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"status": "None outstanding", "resolved_on": "2026-08-20", "rationale": "A prior note flagged BackgroundVideo.playIntro()'s comment for claiming LandingSequence waits on video:intro:complete to trigger hero.playLanding(). That comment no longer exists \u2014 playIntro() now carries only a reduced-motion note, and hero.playLanding appears nowhere in organisms/background/ or templates/landing/. The chain has always triggered bio.playIntro(); the mermaid diagram (VIC \u2192 BEAT \u2192 GEL \u2192 BIO) is the accurate account."}}, {"id": "js_choreography_templates_landing_landingsequence_out_of_band_sections", "label": "Out-of-Band Self-Driven Sections", "file_type": "concept", "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L52-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "attributes": {"sections": "hero, process, awards, organizations, work", "rationale": "These sections are driven by their own ScrollTriggers rather than the serial landing chain, so they are out of band from LandingSequence's narrative pacing."}}], "edges": [{"source": "js_choreography_templates_landing_landingsequence_boot_gates", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L31-L36", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_landingsequence", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L20-L50", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_outro_cue_deadlock_avoidance", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L69", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_animationbus_contract", "target": "js_choreography_templates_landing_landingsequence_landingsequence", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L70", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_reduced_motion_zeroed_holds", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L61-L71", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_delayedcall_timers", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L72", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_bio_disengaged_from_scroll", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L73", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_gel_entrance_gate", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L74", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_known_drift", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L80", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_known_drift", "target": "js_choreography_templates_landing_landingsequence_landingsequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L76-L81", "weight": 1.0}, {"source": "js_choreography_templates_landing_landingsequence_out_of_band_sections", "target": "js_choreography_templates_landing_landingsequence_serial_landing_chain", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "js/choreography/templates/landing/LandingSequence.md", "source_location": "L52-L59", "weight": 1.0}, {"source": "js_choreograp