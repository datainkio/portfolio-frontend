		{"id":"ec3369c90abb3e81","type":"file","file":"dataink.io/frontend/js/preloader/Preloader.md","subpath":"#^d8447f","x":3840,"y":534,"width":400,"height":140,"color":"3"},
		{"id":"2d428a1d03f857c6","type":"text","text":"📍`fonts.ready` resolved (≤2000ms)\n📍`director:ready` received (≤8000ms)","x":3840,"y":684,"width":400,"height":50,"color":"3"},
		{"id":"55b5f5516b07ff75","type":"file","file":"dataink.io/frontend/js/preloader/Preloader.md","subpath":"#^d26777","x":4280,"y":741,"width":400,"height":140,"color":"3"},
		{"id":"31821a1259e76b01","type":"text","text":"📍`data-preloader-state=\"exit\"` set → 📍outro landed — logo `finished` (≤1000ms) → 📍`preloader.hidden = true`","x":4280,"y":929,"width":400,"height":70,"color":"3"},
		{"id":"fd9feb619360786d","type":"file","file":"dataink.io/frontend/js/preloader/Preloader.md","subpath":"#^1a429c","x":4280,"y":1050,"width":400,"height":100,"color":"3"},
		{"id":"31edb38be6bf60a8","type":"file","file":"dataink.io/frontend/js/preloader/Preloader.md","subpath":"#^ca5d32","x":4280,"y":1210,"width":400,"height":180,"color":"3"},
		{"id":"904aea06b902df62","type":"file","file":"dataink.io/frontend/js/preloader/Preloader.md","subpath":"#^9c8d87","x":3840,"y":741,"width":400,"height":140,"color":"3"},
		{"id":"2a269eb0bcf99618","type":"text","text":"📍deferred videos hydrated (`src` set)\n📍background video `playing` (≤4000ms)","x":3840,"y":929,"width":400,"height":50,"color":"3"},
		{"id":"81d683efb227e38e","type":"file","file":"dataink.io/frontend/js/preloader/Preloader.md","subpath":"#^e82137","x":4280,"y":534,"width":400,"height":140,"color":"3"},
		{"id":"128a722847d451fa","type":"text","text":"📍intro landed — subtitle animations `finished` (≤1000ms)","x":4280,"y":684,"width":400,"height":50,"color":"3"},
		{"id":"5e5dbd182498a998","type":"text","text":"### No effect on home\n`overflow: hidden` only blocks native user scroll. ScrollSmoother (`normalizeScroll: true`) is created later by the Director and drives scroll programmatically, bypassing the lock. Real lever: `smoother.paused(true)` — reachable only after `director:ready`.","x":3240,"y":926,"width":400,"height":55,"color":"1"},
		{"id":"e19e43edc57d78d3","type":"text","text":"#7 · Deprioritize below-fold media (S)\nCard `<img>`s (e.g. 3942×2958 PNG) and card posters fetch eagerly at parse, competing with DraftPaper, the bundle and the hero mp4. `loading=lazy decoding=async` on card images, `fetchpriority=low` on card posters, `fetchpriority=high` on the hero poster.","x":-1130,"y":-326,"width":420,"height":226,"color":"1"},
		{"id":"80d3956244feed97","x":-1075,"y":-518,"width":310,"height":60,"type":"text","text":"### What is the impact of this?"}
	],
