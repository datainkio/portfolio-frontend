		{"id":"1566d629d9543fcf","type":"text","text":"📍idle callback fires → `new AnimationDirector()`\n(bundle module evaluated earlier; GSAP plugins registered then, no `window.gsap`)","x":1940,"y":855,"width":400,"height":80,"color":"1"},
